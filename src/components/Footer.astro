---
import { profile } from "../../content/data/profile";
import { translatorFor } from "../i18n/astro";
import { formatLocalTime } from "../lib/clock";
import { filled } from "../lib/placeholders";
import { site } from "../site.config";

interface Props {
  /** Hide links to pages that are still drafts. */
  showUses?: boolean;
}

const { showUses = true } = Astro.props;
const t = translatorFor(Astro);
const year = String(new Date().getUTCFullYear());
const now = new Date();
const place = [filled(profile.location.city), profile.location.country].filter(Boolean).join(", ");
---

<footer class="site-footer">
  <div class="container-page">
    <div class="site-footer__cta card">
      <div>
        <p class="site-footer__cta-title">{t("footer.cta")}</p>
        <p class="site-footer__cta-body">{t("footer.ctaBody")}</p>
      </div>
      <div class="site-footer__cta-actions">
        <a href={`mailto:${profile.email}`} class="button button--primary">
          {profile.email}
        </a>
        <a href="/hire/" class="button">
          {t("nav.hire")} →
        </a>
      </div>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__name">{profile.name}</p>
        <p class="site-footer__colophon">{t("footer.colophon")}</p>
        <button type="button" class="site-footer__palette" data-palette-open>
          <kbd>⌘K</kbd>
          {t("palette.title")}
        </button>
      </div>
      <nav aria-label={t("footer.elsewhere")}>
        <p class="label site-footer__heading">{t("footer.elsewhere")}</p>
        <ul role="list">
          {site.social.map((item) => (
            <li>
              <a href={item.href} rel="me noopener">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t("footer.site")}>
        <p class="label site-footer__heading">{t("footer.site")}</p>
        <ul role="list">
          {showUses && (
            <li>
              <a href="/uses/">{t("nav.uses")}</a>
            </li>
          )}
          <li>
            <a href="/tags/">{t("tags.title")}</a>
          </li>
          <li>
            <a href="/cv.pdf" download>
              {t("palette.downloadCv")}
            </a>
          </li>
          <li>
            <a href={site.repository}>{t("footer.source")}</a>
          </li>
        </ul>
      </nav>
      <nav aria-label={t("footer.feeds")}>
        <p class="label site-footer__heading">{t("footer.feeds")}</p>
        <ul role="list">
          <li>
            <a href="/rss.xml">RSS</a>
          </li>
          <li>
            <a href="/atom.xml">Atom</a>
          </li>
          <li>
            <a href="/feed.json">JSON Feed</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__fine">
      <p>{t("footer.copyright", { year })}</p>
      <p>
        {place} · {t("nav.localTime")}{" "}
        <time data-clock data-time-zone={profile.location.timeZone} datetime={now.toISOString()}>
          {formatLocalTime(now, profile.location.timeZone)}
        </time>
      </p>
      <a href="#top">{t("footer.backToTop")} ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--spacing-section) 2rem;
  }

  .site-footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    overflow: hidden;
    background:
      radial-gradient(30rem 12rem at 0% 0%, var(--glow-1), transparent 70%),
      radial-gradient(24rem 12rem at 100% 100%, var(--glow-2), transparent 70%), var(--paper-raised);
  }

  .site-footer__cta-title {
    font-size: var(--text-step-3);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .site-footer__cta-body {
    margin-block-start: 0.5rem;
    color: var(--ink-muted);
  }

  .site-footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-block-start: 3.5rem;
  }

  .site-footer__name {
    font-weight: 600;
  }

  .site-footer__colophon {
    max-width: 30ch;
    margin-block: 0.5rem 1rem;
    font-size: var(--text-step--1);
    color: var(--ink-muted);
  }

  .site-footer__palette {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .site-footer__palette:hover {
    color: var(--ink);
  }

  .site-footer__heading {
    margin-block-end: 0.75rem;
  }

  .site-footer__grid ul {
    display: grid;
    gap: 0.1rem;
  }

  .site-footer__grid a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: var(--text-step--1);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .site-footer__grid a:hover {
    color: var(--ink);
  }

  .site-footer__fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
    font-size: var(--text-step--2);
    color: var(--ink-faint);
  }

  .site-footer__fine time {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .site-footer__fine a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__fine a:hover {
    color: var(--ink);
  }

  @media (width < 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }
  }
</style>
