---
import { profile } from "../../content/data/profile";
import { translatorFor } from "../i18n/astro";
import { site } from "../site.config";

const t = translatorFor(Astro);
const year = String(new Date().getUTCFullYear());
const [local, domain] = profile.email.split("@");
---

<footer class="site-footer">
  <div class="container-page">
    <a href={`mailto:${profile.email}`} class="site-footer__email">
      <span>{local}</span>
      <span class="site-footer__at">@</span>
      <wbr />
      <span>{domain}</span>
    </a>
    <div class="site-footer__grid">
      <nav aria-label={t("footer.elsewhere")}>
        <p class="label site-footer__heading">{t("footer.elsewhere")}</p>
        <ul role="list">
          {site.social.map((profile) => (
            <li>
              <a href={profile.href} rel="me noopener">
                {profile.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t("footer.feeds")}>
        <p class="label site-footer__heading">{t("footer.feeds")}</p>
        <ul role="list">
          <li>
            <a href="/rss.xml">RSS</a>
          </li>
          <li>
            <a href="/atom.xml">Atom</a>
          </li>
          <li>
            <a href="/feed.json">JSON Feed</a>
          </li>
        </ul>
      </nav>
      <nav aria-label={t("footer.site")}>
        <p class="label site-footer__heading">{t("footer.site")}</p>
        <ul role="list">
          <li>
            <a href="/uses/">{t("nav.uses")}</a>
          </li>
          <li>
            <a href="/tags/">{t("tags.title")}</a>
          </li>
          <li>
            <a href="/cv.pdf" download>
              {t("palette.downloadCv")}
            </a>
          </li>
          <li>
            <a href={site.repository}>{t("footer.source")}</a>
          </li>
        </ul>
      </nav>
      <div class="site-footer__colophon">
        <p>{t("footer.colophon")}</p>
        <button type="button" class="site-footer__palette" data-palette-open>
          <kbd>⌘K</kbd>
          {t("palette.title")}
        </button>
      </div>
    </div>
    <div class="site-footer__fine label">
      <p>{t("footer.copyright", { year })}</p>
      <a href="#top">{t("footer.backToTop")} ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--spacing-section) 1.5rem;
    border-block-start: 2px solid var(--rule-strong);
  }

  .site-footer__email {
    display: block;
    font-weight: 900;
    font-size: clamp(2.1rem, 0.4rem + 7.6vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) ease;
  }

  .site-footer__at {
    display: inline-block;
    margin-inline: 0.04em;
    padding-inline: 0.02em;
    background: var(--signal);
    color: var(--on-accent);
    line-height: 0.95;
  }

  .site-footer__email:hover {
    color: var(--signal-text);
  }

  .site-footer__email:hover .site-footer__at {
    background: var(--ink);
    color: var(--paper);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.5fr);
    gap: 2rem;
    margin-block-start: clamp(2.5rem, 5vw, 4.5rem);
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule-strong);
  }

  .site-footer__heading {
    margin-block-end: 0.75rem;
  }

  .site-footer__grid ul {
    display: grid;
    gap: 0.15rem;
  }

  .site-footer__grid a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    font-weight: 600;
    text-decoration: none;
  }

  .site-footer__grid a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
  }

  .site-footer__colophon {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .site-footer__palette {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: var(--ink);
    font: 500 var(--text-step--2) / 1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .site-footer__palette kbd {
    padding: 0.35em 0.5em;
    border: 2px solid var(--rule-strong);
    font: inherit;
  }

  .site-footer__fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 3rem;
  }

  .site-footer__fine a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block: -1rem;
    color: var(--ink);
    text-decoration: none;
  }

  @media (width < 56rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
