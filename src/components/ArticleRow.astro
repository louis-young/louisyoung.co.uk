---
import { formatDate, isoDate } from "../i18n";
import { localeOf } from "../i18n/astro";
import { articlePath, type Article } from "../lib/articles";

interface Props {
  article: Article;
  headingLevel?: "h2" | "h3";
  /** Title and date only, for dense lists such as the home page. */
  compact?: boolean;
}

const { article, headingLevel: Heading = "h3", compact = false } = Astro.props;
const locale = localeOf(Astro);
---

<article class:list={["article-row", { "article-row--compact": compact }]} data-topics={article.data.tags.join(" ")}>
  <Heading class="article-row__title">
    <a href={articlePath(article)} class="article-row__link">
      {article.data.title}
    </a>
  </Heading>
  {!compact && <p class="article-row__description">{article.data.description}</p>}
  <time class="article-row__date" datetime={isoDate(article.data.date)}>
    {formatDate(article.data.date, locale)}
  </time>
  <span class="article-row__arrow" aria-hidden="true">
    →
  </span>
</article>

<style>
  .article-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.25rem;
    grid-template-areas:
      "title date arrow"
      "description description description";
    align-items: baseline;
    gap: 0.35rem 1.25rem;
    padding: 1.1rem 1rem;
    margin-inline: -1rem;
    border-radius: var(--radius-md);
    transition:
      background-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .article-row + :global(.article-row)::before {
    content: "";
    position: absolute;
    inset: 0 1rem auto;
    border-block-start: 1px solid var(--rule);
    transition: opacity var(--duration-fast) ease;
  }

  /* When a filter hides rows, the first one still showing needs no rule above it. */
  :global(.article-row:nth-child(1 of :not([hidden])))::before {
    display: none;
  }

  .article-row__title {
    grid-area: title;
    font-weight: 550;
    font-size: var(--text-step-1);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .article-row--compact .article-row__title {
    font-size: var(--text-step-0);
  }

  .article-row__link {
    text-decoration: none;
  }

  /* The whole row is the hit target, but only the title is the link's accessible name. */
  .article-row__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .article-row__link:focus-visible {
    outline: none;
  }

  .article-row:has(.article-row__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .article-row__date {
    grid-area: date;
    font: 500 var(--text-step--2) / 1 var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .article-row__arrow {
    grid-area: arrow;
    justify-self: end;
    color: var(--accent);
    opacity: 0;
    translate: -0.35rem 0;
    transition:
      opacity var(--duration-base) ease,
      translate var(--duration-base) var(--ease-out-expo);
  }

  .article-row__description {
    grid-area: description;
    max-width: 68ch;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
    line-height: 1.6;
  }

  @media (hover: hover) {
    .article-row:hover {
      background: color-mix(in oklch, var(--paper-raised) 80%, transparent);
      box-shadow: inset 0 0 0 1px var(--rule);
    }

    /* The highlighted row brings its own edge, so the rules either side of it step back. */
    .article-row:hover::before,
    .article-row:hover + :global(.article-row)::before {
      opacity: 0;
    }

    .article-row:hover .article-row__date {
      color: var(--ink-muted);
    }

    .article-row:hover .article-row__arrow {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (width < 40rem) {
    .article-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "description"
        "date";
    }

    .article-row__arrow {
      display: none;
    }
  }
</style>
