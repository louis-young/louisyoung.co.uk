---
import { formatDate, isoDate } from "../i18n";
import { localeOf } from "../i18n/astro";
import { articlePath, type Article } from "../lib/articles";

interface Props {
  article: Article;
  headingLevel?: "h2" | "h3";
  /** Title and date only, for dense lists such as the home page. */
  compact?: boolean;
}

const { article, headingLevel: Heading = "h3", compact = false } = Astro.props;
const locale = localeOf(Astro);
---

<article class:list={["article-row", { "article-row--compact": compact }]}>
  <Heading class="article-row__title">
    <a href={articlePath(article)} class="article-row__link">
      {article.data.title}
    </a>
  </Heading>
  {!compact && <p class="article-row__description">{article.data.description}</p>}
  <time class="article-row__date" datetime={isoDate(article.data.date)}>
    {formatDate(article.data.date, locale)}
  </time>
  <span class="article-row__arrow" aria-hidden="true">
    →
  </span>
</article>

<style>
  .article-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.5rem;
    grid-template-areas:
      "title date arrow"
      "description description description";
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding-block: 1.4rem;
    border-block-start: 1px solid var(--rule-strong);
    transition: padding var(--duration-base) var(--ease-out-expo);
  }

  .article-row__title {
    grid-area: title;
    font-weight: 700;
    font-size: var(--text-step-1);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .article-row__link {
    text-decoration: none;
  }

  /* The whole row is the hit target, but only the title is the link's accessible name. */
  .article-row__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .article-row__link:focus-visible {
    outline: none;
  }

  .article-row:has(.article-row__link:focus-visible) {
    outline: 3px solid var(--signal);
    outline-offset: 2px;
  }

  .article-row__date {
    grid-area: date;
    font: 500 var(--text-step--2) / 1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .article-row__arrow {
    grid-area: arrow;
    justify-self: end;
    font-weight: 700;
    color: var(--signal-text);
    opacity: 0;
    translate: -0.5rem 0;
    transition:
      opacity var(--duration-base) ease,
      translate var(--duration-base) var(--ease-out-expo);
  }

  .article-row__description {
    grid-area: description;
    max-width: 68ch;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
    line-height: 1.6;
  }

  @media (hover: hover) {
    .article-row:hover {
      padding-inline-start: 0.75rem;
    }

    .article-row:hover .article-row__arrow {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (width < 40rem) {
    .article-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "description"
        "date";
    }

    .article-row__arrow {
      display: none;
    }
  }
</style>
