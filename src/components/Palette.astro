---
import { translatorFor } from "../i18n/astro";
import { site } from "../site.config";

interface Item {
  title: string;
  href: string;
  keywords?: string;
}

interface Props {
  work: readonly Item[];
  articles: readonly Item[];
  /** Pages hidden from the navigation while they are drafts. */
  hidden?: readonly string[];
}

const t = translatorFor(Astro);
const { work, articles, hidden = [] } = Astro.props;

interface Option {
  title: string;
  keywords?: string | undefined;
  href?: string;
  action?: string;
  value?: string;
  done?: string;
  hint?: string;
}

const groups: { id: string; label: string; options: Option[] }[] = [
  {
    id: "pages",
    label: t("palette.pages"),
    options: [
      { title: t("nav.home"), href: "/", hint: "/" },
      { title: t("nav.work"), href: "/work/", hint: "/work" },
      { title: t("nav.writing"), href: "/writing/", hint: "/writing" },
      { title: t("nav.hire"), href: "/hire/", hint: "/hire" },
      { title: t("nav.cv"), href: "/cv/", hint: "/cv" },
      { title: t("nav.now"), href: "/now/", hint: "/now" },
      { title: t("nav.uses"), href: "/uses/", hint: "/uses" },
      { title: t("tags.title"), href: "/tags/", hint: "/tags" },
    ].filter((option) => !hidden.includes(option.href)),
  },
  {
    id: "actions",
    label: t("palette.actions"),
    options: [
      { title: t("palette.search"), action: "search", hint: "/" },
      { title: t("hire.book"), href: "/hire/#book" },
      {
        title: t("palette.copyEmail"),
        action: "copy",
        value: site.author.email,
        done: t("palette.copied"),
        keywords: site.author.email,
      },
      { title: t("palette.downloadCv"), href: "/cv.pdf", action: "download" },
      { title: t("palette.theme"), action: "theme", hint: "T" },
    ],
  },
  { id: "work", label: t("palette.work"), options: work.map((item) => ({ ...item })) },
  { id: "writing", label: t("palette.writing"), options: articles.map((item) => ({ ...item })) },
];
---

<dialog
  id="palette"
  class="palette"
  aria-labelledby="palette-title"
  data-count-one={t("palette.countOne")}
  data-count-other={t("palette.countOther")}
>
  <h2 id="palette-title" class="visually-hidden">
    {t("palette.title")}
  </h2>
  <div class="palette__search">
    <svg class="palette__prompt" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="m20 20-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <input
      type="text"
      class="palette__input"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label={t("palette.title")}
      placeholder={t("palette.placeholder")}
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" class="palette__esc" data-palette-close aria-label={t("palette.close")}>
      <kbd>Esc</kbd>
    </button>
  </div>
  <div id="palette-list" class="palette__list" role="listbox" aria-label={t("palette.title")}>
    <div role="none" class="palette__results" data-palette-results hidden></div>
    {groups.map((group) => (
      <div role="group" aria-labelledby={`palette-group-${group.id}`} data-group={group.id}>
        <div id={`palette-group-${group.id}`} class="palette__group label">
          {group.label}
        </div>
        <div role="none" class="palette__options">
          {group.options.map((option, index) => (
            <div
              role="option"
              id={`palette-${group.id}-${index}`}
              class="palette__option"
              aria-selected="false"
              data-group={group.id}
              data-title={option.title}
              data-keywords={option.keywords}
              data-href={option.href}
              data-action={option.action}
              data-value={option.value}
              data-done={option.done}
            >
              <span class="palette__title">{option.title}</span>
              {option.hint && (
                <span class="palette__hint" aria-hidden="true">
                  {option.hint}
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="palette__empty" data-palette-empty hidden>
    {t("palette.empty")}
  </p>
  <p class="visually-hidden" role="status" data-palette-status></p>
  <div class="palette__footer label" aria-hidden="true">
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> {t("palette.navigate")}
    </span>
    <span>
      <kbd>↵</kbd> {t("palette.select")}
    </span>
    <span>
      <kbd>Esc</kbd> {t("palette.close")}
    </span>
  </div>
</dialog>

<style>
  .palette {
    width: min(100% - 2rem, 40rem);
    max-height: min(80dvh, 34rem);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--paper-raised) 92%, transparent);
    color: var(--ink);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--ink) 4%, transparent),
      0 30px 80px -20px oklch(0% 0 0 / 0.55),
      0 0 60px -10px var(--glow-1);
    backdrop-filter: blur(20px) saturate(1.4);
    overflow: hidden;
  }

  .palette[open] {
    display: flex;
    flex-direction: column;
  }

  .palette::backdrop {
    background: oklch(10% 0.01 270 / 0.5);
    backdrop-filter: blur(4px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      animation: palette-in var(--duration-base) var(--ease-out-expo);
    }
  }

  .palette__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: 1.1rem 0.6rem;
    border-block-end: 1px solid var(--rule);
  }

  .palette__prompt {
    flex-shrink: 0;
    color: var(--ink-faint);
  }

  .palette__input {
    flex: 1;
    min-width: 0;
    min-height: 3.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: 400 var(--text-step-0) / 1.2 var(--sans);
  }

  .palette__input:focus-visible {
    outline: none;
  }

  .palette__input::placeholder {
    color: var(--ink-faint);
  }

  .palette__esc {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--ink-muted);
  }

  .palette__list {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.25rem 0.5rem 0.5rem;
  }

  .palette__group {
    padding: 0.85rem 0.75rem 0.35rem;
  }

  .palette__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .palette__option[aria-selected="true"] {
    background: color-mix(in oklch, var(--accent) 16%, transparent);
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .palette__option[aria-selected="true"] .palette__hint {
    color: var(--ink-muted);
  }

  .palette__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette__hint {
    flex-shrink: 0;
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--ink-faint);
  }

  .palette__empty {
    padding: 1.25rem 1.25rem 1.5rem;
    color: var(--ink-muted);
  }

  .palette__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.65rem 1.1rem;
    border-block-start: 1px solid var(--rule);
    background: color-mix(in oklch, var(--paper-sunken) 60%, transparent);
  }

  .palette__footer :global(kbd) {
    margin-inline-end: 0.2em;
  }

  @media (width < 36rem) {
    .palette {
      margin-block-start: 1rem;
    }

    .palette__footer {
      display: none;
    }
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      scale: 0.97;
      translate: 0 -0.5rem;
    }
  }
</style>
