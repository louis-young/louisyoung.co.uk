---
import { translatorFor } from "../i18n/astro";

const t = translatorFor(Astro);

/**
 * The palette's shell. Its options are fetched from `/palette.json` when it is first warmed and
 * rendered into these groups by `src/scripts/palette.ts`, so they aren't repeated in every page.
 */
const groups = [
  { id: "pages", label: t("palette.pages") },
  { id: "actions", label: t("palette.actions") },
  { id: "work", label: t("palette.work") },
  { id: "writing", label: t("palette.writing") },
  { id: "snippets", label: t("palette.snippets") },
];
---

<dialog
  id="palette"
  class="palette"
  aria-labelledby="palette-title"
  data-index="/palette.json"
  data-count-one={t("palette.countOne")}
  data-count-other={t("palette.countOther")}
>
  <h2 id="palette-title" class="visually-hidden">
    {t("palette.title")}
  </h2>
  <div class="palette__search">
    <svg class="palette__prompt" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="m20 20-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <input
      type="text"
      class="palette__input"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label={t("palette.title")}
      placeholder={t("palette.placeholder")}
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" class="palette__esc" data-palette-close aria-label={t("palette.close")}>
      <kbd>Esc</kbd>
    </button>
  </div>
  {/* Options are reached with the arrow keys from the combobox, so the list itself is not a Tab stop. */}
  <div id="palette-list" class="palette__list" role="listbox" aria-label={t("palette.title")} tabindex="-1">
    <div role="none" class="palette__results" data-palette-results hidden></div>
    {groups.map((group) => (
      <div role="group" aria-labelledby={`palette-group-${group.id}`} data-group={group.id} hidden>
        <div id={`palette-group-${group.id}`} class="palette__group label">
          {group.label}
        </div>
        <div role="none" class="palette__options"></div>
      </div>
    ))}
  </div>
  <p class="palette__note palette__loading" data-palette-loading hidden>
    <span class="palette__spinner" aria-hidden="true"></span>
    {t("palette.loading")}
  </p>
  <div class="palette__note palette__error" data-palette-error hidden>
    <p>{t("palette.error")}</p>
    <button type="button" class="button button--small" data-palette-retry>
      {t("palette.retry")}
    </button>
  </div>
  <p class="palette__note" data-palette-empty hidden>
    {t("palette.empty")}
  </p>
  <p class="visually-hidden" role="status" data-palette-status></p>
  <div class="palette__footer label" aria-hidden="true">
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> {t("palette.navigate")}
    </span>
    <span>
      <kbd>↵</kbd> {t("palette.select")}
    </span>
    <span>
      <kbd>Esc</kbd> {t("palette.close")}
    </span>
  </div>
</dialog>

<style>
  .palette {
    width: min(100% - 2rem, 40rem);
    max-height: min(80dvh, 34rem);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    /* Opaque rather than a backdrop blur, which stalls WebKit's software renderer. */
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--ink) 4%, transparent),
      0 30px 80px -20px oklch(0% 0 0 / 0.55),
      0 0 60px -10px var(--glow-1);
    overflow: hidden;
  }

  .palette[open] {
    display: flex;
    flex-direction: column;
  }

  .palette::backdrop {
    background: oklch(10% 0.01 270 / 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      animation: palette-in var(--duration-base) var(--ease-out-expo);
    }
  }

  .palette__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: 1.1rem 0.6rem;
    border-block-end: 1px solid var(--rule);
  }

  .palette__prompt {
    flex-shrink: 0;
    color: var(--ink-faint);
  }

  .palette__input {
    flex: 1;
    min-width: 0;
    min-height: 3.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: 400 var(--text-step-0) / 1.2 var(--sans);
  }

  .palette__input:focus-visible {
    outline: none;
  }

  /* The input's focus shows as an accent rule under the search row. */
  .palette__search:has(.palette__input:focus-visible) {
    border-block-end-color: var(--accent);
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  .palette__input::placeholder {
    color: var(--ink-faint);
  }

  .palette__esc {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--ink-muted);
  }

  .palette__list {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.25rem 0.5rem 0.5rem;
  }

  .palette__group {
    padding: 0.85rem 0.75rem 0.35rem;
  }

  /* Options are built by the script, so these rules can't rely on Astro's scoping attribute. */
  .palette :global(.palette__option) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .palette :global(.palette__option[aria-selected="true"]) {
    background: color-mix(in oklch, var(--accent) 16%, transparent);
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .palette :global(.palette__option[aria-selected="true"] .palette__hint) {
    color: var(--ink-muted);
  }

  .palette :global(.palette__title) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette :global(.palette__hint) {
    flex-shrink: 0;
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--ink-faint);
  }

  /* The quick answer: a larger row at the top of the results, above the pages that match. */
  .palette :global(.palette__answer) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.35rem 1rem;
    margin-block: 0.4rem 0.25rem;
    padding: 0.75rem 0.9rem 0.85rem;
    border: 1px solid var(--rule);
    background: var(--paper-sunken);
  }

  /* Selected, it keeps its sunken surface (its faint labels are held to 4.5:1 on it) and gains the accent edge. */
  .palette :global(.palette__answer[aria-selected="true"]) {
    border-color: var(--accent);
    background: var(--paper-sunken);
  }

  .palette :global(.palette__answer-label) {
    color: var(--signal-text);
  }

  .palette :global(.palette__answer .palette__hint) {
    display: flex;
    gap: 0.4em;
    align-items: center;
  }

  .palette :global(.palette__answer-main) {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .palette :global(.palette__answer-value) {
    overflow-wrap: anywhere;
    font: 500 var(--text-step-1) / 1.25 var(--mono);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .palette :global(.palette__answer[data-kind="cron"] .palette__answer-value) {
    font-family: var(--sans);
    letter-spacing: -0.015em;
  }

  .palette :global(.palette__swatch) {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .palette :global(.palette__answer-details) {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font: 400 var(--text-step--2) / 1.4 var(--mono);
    color: var(--ink-muted);
  }

  .palette :global(.palette__answer-details > span) {
    display: inline-flex;
    gap: 0.5em;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .palette :global(.palette__answer-details .label) {
    color: var(--ink-faint);
  }

  .palette__note {
    padding: 1.25rem 1.25rem 1.5rem;
    color: var(--ink-muted);
  }

  .palette__loading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .palette__loading[hidden],
  .palette__error[hidden] {
    display: none;
  }

  .palette__spinner {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--rule-strong);
    border-block-start-color: var(--accent);
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette__spinner {
      animation: palette-spin 0.8s linear infinite;
    }
  }

  .palette__error {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .palette__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.65rem 1.1rem;
    border-block-start: 1px solid var(--rule);
    background: color-mix(in oklch, var(--paper-sunken) 60%, transparent);
  }

  .palette__footer :global(kbd) {
    margin-inline-end: 0.2em;
  }

  @media (width < 36rem) {
    .palette {
      margin-block-start: 1rem;
    }

    .palette__footer {
      display: none;
    }

    .palette :global(.palette__answer-value) {
      font-size: var(--text-step-0);
    }
  }

  /* Forced colours drop backgrounds and shadows, which is all that marked the active option. */
  @media (forced-colors: active) {
    .palette__search:has(.palette__input:focus-visible) {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }

    .palette :global(.palette__option[aria-selected="true"]) {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }

    .palette :global(.palette__option[aria-selected="true"] *) {
      color: HighlightText;
    }

    /* The swatch is the colour itself, so keep it. */
    .palette :global(.palette__swatch) {
      forced-color-adjust: none;
    }
  }

  @keyframes palette-spin {
    to {
      rotate: 1turn;
    }
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      scale: 0.97;
      translate: 0 -0.5rem;
    }
  }
</style>
