---
import { translatorFor } from "../i18n/astro";
import { toolPath, type tools } from "../lib/tool-catalogue";

interface Props {
  tool: (typeof tools)[number];
}

const t = translatorFor(Astro);
const { tool } = Astro.props;
---

{/* A tool on the tools index or under "Related tools". Both nest it under an h2. */}
<div class="tool-card card card--interactive">
  <span class="tool-card__icon" aria-hidden="true" data-tool-icon>
    {tool.icon}
  </span>
  <h3 class="tool-card__title">
    <a href={toolPath(tool.slug)} class="stretched-link" data-tool-link>
      {t(tool.title)}
    </a>
  </h3>
  <p class="tool-card__summary">{t(tool.summary)}</p>
</div>

<style>
  .tool-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    align-content: start;
    gap: 0.75rem 0.9rem;
    height: 100%;
    padding: 1.25rem;
  }

  .tool-card__icon {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.4rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--accent) 10%, transparent);
    color: var(--accent);
    font: 600 var(--text-step--1) / 1 var(--mono);
    white-space: nowrap;
  }

  .tool-card__title {
    font-weight: 600;
    font-size: var(--text-step-0);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .tool-card__title a {
    text-decoration: none;
  }

  .tool-card__summary {
    grid-column: 1 / -1;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
    line-height: 1.55;
  }
</style>
