---
import { translatorFor } from "../i18n/astro";
import type { TocItem } from "../lib/toc";

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
const t = translatorFor(Astro);
---

{items.length > 1 && (
  <nav class="toc" aria-labelledby="toc-title">
    <details class="toc__details" open>
      <summary id="toc-title" class="toc__title eyebrow">
        {t("article.contents")}
      </summary>
      <ol class="toc__list" role="list">
        {items.map((item) => (
          <li>
            <a href={`#${item.slug}`} class="toc__link" data-toc-link={item.slug}>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ol class="toc__list toc__list--nested" role="list">
                {item.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`} class="toc__link" data-toc-link={child.slug}>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].map((link) => [
      link.dataset["tocLink"]!,
      link,
    ]),
  );
  const headings = [...links.keys()].flatMap((id) => document.getElementById(id) ?? []);

  if (headings.length > 0 && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const update = () => {
      const current = headings.find((heading) => visible.has(heading.id))?.id;
      if (!current) return;
      for (const [id, link] of links) {
        if (id === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        update();
      },
      { rootMargin: "-80px 0px -65% 0px" },
    );
    for (const heading of headings) observer.observe(heading);
  }
</script>

<style>
  .toc__title {
    cursor: pointer;
    list-style: none;
    padding-block-end: 0.75rem;
  }

  .toc__title::-webkit-details-marker {
    display: none;
  }

  .toc__list {
    display: grid;
    gap: 0.1rem;
    border-inline-start: 1px solid var(--rule);
    font-size: var(--text-step--1);
    line-height: 1.4;
  }

  .toc__list--nested {
    margin-block: 0.1rem 0.3rem;
    margin-inline-start: 0.85rem;
    border: 0;
  }

  .toc__link {
    position: relative;
    display: block;
    padding: 0.3rem 0 0.3rem 1rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .toc__link:hover {
    color: var(--ink);
  }

  .toc__link[aria-current="location"] {
    color: var(--accent);
  }

  .toc__list:not(.toc__list--nested) > li > .toc__link[aria-current="location"]::before,
  .toc__list--nested .toc__link[aria-current="location"]::before {
    content: "";
    position: absolute;
    inset-block: 0.3rem;
    inset-inline-start: -1px;
    width: 2px;
    background: currentColor;
  }

  .toc__list--nested .toc__link[aria-current="location"]::before {
    inset-inline-start: calc(-0.85rem - 1px);
  }
</style>
