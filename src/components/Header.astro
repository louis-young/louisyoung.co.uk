---
import { profile } from "../../content/data/profile";
import { translatorFor } from "../i18n/astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Sections only appear in the navigation once they have real (non-placeholder) content. */
  sections?: { work: boolean; now: boolean; cv: boolean };
}

const { sections = { work: true, now: true, cv: true } } = Astro.props;
const t = translatorFor(Astro);
const path = Astro.url.pathname;
const links = [
  { href: "/work/", label: t("nav.work"), show: sections.work },
  { href: "/writing/", label: t("nav.writing"), show: true, also: ["/tags/", "/search/"] },
  { href: "/hire/", label: t("nav.hire"), show: true },
  { href: "/tools/", label: t("nav.tools"), show: true },
  { href: "/cv/", label: t("nav.cv"), show: sections.cv },
  { href: "/now/", label: t("nav.now"), show: sections.now },
]
  .filter((link) => link.show)
  .map((link) => ({
    ...link,
    current: path === link.href,
    section: path.startsWith(link.href) || (link.also ?? []).some((prefix) => path.startsWith(prefix)),
  }));
---

<header class="site-header">
  <div class="container-page site-header__inner">
    <a href="/" class="site-header__name" aria-current={path === "/" ? "page" : undefined}>
      <span class="site-header__mark" aria-hidden="true">
        LY
      </span>
      <span class="site-header__label">{profile.name}</span>
    </a>
    <nav aria-label={t("nav.label")} class="site-nav">
      <ul class="site-nav__list" role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="site-nav__link"
              aria-current={link.current ? "page" : link.section ? "true" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__tools">
      <button
        type="button"
        class="site-header__palette"
        data-palette-open
        aria-label={t("palette.open")}
        aria-keyshortcuts="Meta+K Control+K"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd>⌘K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-block-end: 1px solid color-mix(in oklch, var(--rule) 70%, transparent);
    /* Nearly opaque rather than a live backdrop blur, which re-renders on every scroll frame. */
    background: color-mix(in oklch, var(--paper) 92%, transparent);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .site-header__name {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    justify-self: start;
    min-height: 2.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-header__mark {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.55rem;
    background: linear-gradient(135deg, oklch(62% 0.2 290), oklch(64% 0.16 240));
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    box-shadow: 0 6px 18px -6px var(--glow-1);
    transition: rotate var(--duration-slow) var(--ease-out-expo);
  }

  .site-header__name:hover .site-header__mark {
    rotate: -8deg;
  }

  .site-nav__list {
    display: flex;
    gap: 0.15rem;
    padding: 0.25rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklch, var(--paper-raised) 60%, transparent);
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.9rem;
    border-radius: 999px;
    font-size: var(--text-step--1);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link[aria-current] {
    background: var(--paper-sunken);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--rule) inset;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.35rem;
  }

  .site-header__palette {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 0.45rem 0 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-faint);
    background: color-mix(in oklch, var(--paper-raised) 60%, transparent);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .site-header__palette:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  @media (width < 56rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      padding-block-start: 0.35rem;
    }

    .site-nav {
      grid-row: 2;
      grid-column: 1 / -1;
      /* Grid items default to min-width: auto, which would let a long nav widen the page. */
      min-width: 0;
      overflow-x: auto;
      padding-block-end: 0.6rem;
      scrollbar-width: none;
    }

    .site-nav__list {
      width: max-content;
    }
  }
</style>
