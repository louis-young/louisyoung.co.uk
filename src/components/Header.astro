---
import { profile } from "../../content/data/profile";
import { translatorFor } from "../i18n/astro";
import { formatLocalTime } from "../lib/clock";
import ThemeToggle from "./ThemeToggle.astro";

const t = translatorFor(Astro);
const path = Astro.url.pathname;
const links = [
  { href: "/work/", label: t("nav.work") },
  { href: "/writing/", label: t("nav.writing"), also: ["/tags/", "/search/"] },
  { href: "/hire/", label: t("nav.hire") },
  { href: "/cv/", label: t("nav.cv") },
  { href: "/now/", label: t("nav.now") },
].map((link, index) => ({
  ...link,
  number: String(index + 1).padStart(2, "0"),
  current: path === link.href,
  section: path.startsWith(link.href) || (link.also ?? []).some((prefix) => path.startsWith(prefix)),
}));
const now = new Date();
---

<header class="site-header">
  <div class="container-page site-header__inner">
    <a href="/" class="site-header__name" aria-current={path === "/" ? "page" : undefined}>
      <span class="site-header__mark" aria-hidden="true"></span>
      {profile.name}
    </a>
    <p class="site-header__place">
      {profile.location.city}, {profile.location.country} · {t("nav.localTime")}{" "}
      <time data-clock data-time-zone={profile.location.timeZone} datetime={now.toISOString()}>
        {formatLocalTime(now, profile.location.timeZone)}
      </time>
    </p>
    <nav aria-label={t("nav.label")} class="site-nav">
      <ol class="site-nav__list" role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="site-nav__link"
              aria-current={link.current ? "page" : link.section ? "true" : undefined}
            >
              <span class="site-nav__number" aria-hidden="true">
                {link.number}
              </span>
              {link.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="site-header__tools">
      <button type="button" class="site-header__palette" data-palette-open aria-label={t("palette.open")}>
        <kbd>⌘K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-block-end: 2px solid var(--rule-strong);
    font: 500 var(--text-step--2) / 1.2 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0.5rem 1.75rem;
    min-height: 4.25rem;
  }

  .site-header__name {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__mark {
    width: 0.85rem;
    height: 0.85rem;
    background: var(--signal);
    transition: rotate var(--duration-slow) var(--ease-out-expo);
  }

  .site-header__name:hover .site-header__mark {
    rotate: 45deg;
  }

  .site-header__place {
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .site-header__place time {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .site-nav__list {
    display: flex;
    gap: 0 1.4rem;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.75rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__number {
    color: var(--ink-faint);
    transition: color var(--duration-fast) ease;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    inset: auto 0 0.55rem;
    height: 2px;
    background: var(--signal);
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--duration-base) var(--ease-out-expo);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current]::after {
    scale: 1 1;
  }

  .site-nav__link:hover .site-nav__number,
  .site-nav__link[aria-current] .site-nav__number {
    color: var(--accent);
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .site-header__palette {
    display: grid;
    place-items: center;
    min-width: 3.25rem;
    min-height: 2.75rem;
    padding-inline: 0.6rem;
    border: 2px solid var(--rule-strong);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .site-header__palette:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .site-header__palette kbd {
    font: inherit;
  }

  @media (width < 72rem) {
    .site-header__place {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .site-nav {
      justify-self: end;
    }
  }

  @media (width < 48rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      min-height: 0;
      padding-block-start: 0.4rem;
    }

    .site-nav {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: stretch;
      margin-inline: calc(-1 * var(--spacing-gutter));
      padding-inline: var(--spacing-gutter);
      border-block-start: 1px solid var(--rule);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav__list {
      gap: 0 1.1rem;
    }
  }
</style>
