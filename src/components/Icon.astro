} as const;

type IconName = keyof typeof strokes | keyof typeof fills;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const isFill = name in fills;
const body = isFill ? fills[name as keyof typeof fills] : strokes[name as keyof typeof strokes];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={isFill ? "currentColor" : "none"}
  stroke={isFill ? "none" : "currentColor"}
  stroke-width={isFill ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={body}
/>
