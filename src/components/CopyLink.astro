---
import { translatorFor } from "../i18n/astro";
import Icon from "./Icon.astro";

const t = translatorFor(Astro);
---

<button type="button" class="button copy-link" data-copy-link data-copied-label={t("article.copied")}>
  <Icon name="link" size={16} class="copy-link__icon" />
  <Icon name="check" size={16} class="copy-link__done" />
  <span data-copy-label>{t("article.share")}</span>
</button>
<span class="sr-only-focusable" role="status" data-copy-status></span>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-link]")) {
    button.addEventListener("click", async () => {
      const url = document.querySelector<HTMLLinkElement>("link[rel=canonical]")?.href ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        button.dataset["copied"] = "";
        const status = button.nextElementSibling;
        if (status) status.textContent = button.dataset["copiedLabel"] ?? "";
        setTimeout(() => {
          delete button.dataset["copied"];
          if (status) status.textContent = "";
        }, 2000);
      } catch {
        window.prompt("", url);
      }
    });
  }
</script>

<style>
  .copy-link :global(.copy-link__done) {
    display: none;
  }

  .copy-link[data-copied] :global(.copy-link__done) {
    display: block;
    color: var(--accent);
  }

  .copy-link[data-copied] :global(.copy-link__icon) {
    display: none;
  }
</style>
