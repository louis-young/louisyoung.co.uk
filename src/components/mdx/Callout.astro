---
import { translatorFor } from "../../i18n/astro";
import Icon from "../Icon.astro";

interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}

const { type = "note", title } = Astro.props;
const t = translatorFor(Astro);
const icons = { note: "info", tip: "tip", warning: "warning" } as const;
---

<div class:list={["callout", `callout--${type}`]} role="note" aria-label={title ?? t(`callout.${type}`)}>
  <p class="callout__title">
    <Icon name={icons[type]} size={18} />
    {title ?? t(`callout.${type}`)}
  </p>
  <div class="callout__body">
    <slot />
  </div>
</div>

<style>
  .callout {
    --callout: var(--ink-muted);
    --callout-soft: var(--paper-raised);

    margin-block: 1.75em;
    padding: 1rem 1.25rem 1.1rem;
    border: 1px solid color-mix(in oklch, var(--callout) 30%, var(--rule));
    border-radius: var(--radius-md);
    background: var(--callout-soft);
    font-size: 0.92em;
  }

  .callout--warning {
    --callout: var(--warning);
    --callout-soft: var(--warning-soft);
  }

  .callout--tip {
    --callout: var(--accent);
    --callout-soft: color-mix(in oklch, var(--accent) 8%, var(--paper-raised));
  }

  .callout__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.35rem;
    font: 600 var(--text-step--2) / 1.3 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--callout);
  }

  .callout__body > :global(* + *) {
    margin-block-start: 0.75em;
  }
</style>
