---
import { cv } from "../../../content/data/cv";
import { translatorFor } from "../../i18n/astro";
import { formatPeriod } from "../../lib/cv";

interface Props {
  /** Show highlights and stack, as on `/cv/`. */
  detailed?: boolean;
  limit?: number;
}

const t = translatorFor(Astro);
const { detailed = false, limit } = Astro.props;
const roles = cv.roles.slice(0, limit);
---

<ol class="roles" role="list">
  {roles.map((role) => (
    <li class="role">
      <p class="role__period">{formatPeriod(role, t("cv.present"))}</p>
      <div>
        <h3 class="role__title">
          {role.role}, {role.company}
        </h3>
        {detailed && <p class="role__location label">{role.location}</p>}
        <p class="role__summary">{role.summary}</p>
        {detailed && (
          <>
            <ul class="role__highlights" role="list">
              {role.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <p class="role__stack label">{role.stack.join(" · ")}</p>
          </>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .roles {
    border-block-end: 1px solid var(--rule-strong);
  }

  .role {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    padding-block: 1.4rem;
    border-block-start: 1px solid var(--rule-strong);
  }

  .role__period {
    padding-block-start: 0.4rem;
    font: 500 var(--text-step--1) / 1.2 var(--mono);
  }

  .role__title {
    font-weight: 700;
    font-size: var(--text-step-1);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .role__location {
    margin-block-start: 0.35rem;
  }

  .role__summary {
    margin-block-start: 0.4rem;
    max-width: 62ch;
    color: var(--ink-muted);
  }

  .role__highlights {
    display: grid;
    gap: 0.4rem;
    margin-block-start: 0.9rem;
    max-width: 66ch;
  }

  .role__highlights li {
    position: relative;
    padding-inline-start: 1.1rem;
  }

  .role__highlights li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--signal);
  }

  .role__stack {
    margin-block-start: 0.9rem;
  }

  @media (width < 40rem) {
    .role {
      grid-template-columns: 1fr;
    }
  }
</style>
