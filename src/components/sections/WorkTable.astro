---
import { translatorFor } from "../../i18n/astro";
import { filled, withoutPlaceholders } from "../../lib/placeholders";
import { workPath, type CaseStudy } from "../../lib/work";

interface Props {
  work: readonly CaseStudy[];
  headingLevel?: "h2" | "h3";
}

const t = translatorFor(Astro);
const { work, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="work-grid" role="list">
  {work.map((study, index) => {
    const meta = [filled(study.data.year), filled(study.data.role)].filter(Boolean).join(" · ");
    return (
      <li class:list={["work-row card card--interactive", { "work-row--feature": index === 0 }]}>
        {meta && <p class="label work-row__meta">{meta}</p>}
        <Heading class="work-row__title">
          <a href={workPath(study)} class="work-row__link stretched-link">
            {study.data.title}
          </a>
        </Heading>
        <p class="work-row__summary">{study.data.summary}</p>
        <ul class="work-row__stack" role="list" aria-label={t("work.stack")}>
          {withoutPlaceholders(study.data.stack).map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
        <span class="work-row__arrow" aria-hidden="true">
          ↗
        </span>
      </li>
    );
  })}
</ul>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .work-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 15rem;
    padding: 1.6rem;
    overflow: hidden;
  }

  .work-row--feature {
    grid-column: 1 / -1;
    min-height: 18rem;
    background:
      radial-gradient(36rem 18rem at 100% 0%, var(--glow-1), transparent 70%),
      color-mix(in oklch, var(--paper-raised) 85%, transparent);
  }

  .work-row__meta {
    color: var(--accent);
  }

  .work-row__title {
    max-width: 22ch;
    font-size: var(--text-step-2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .work-row--feature .work-row__title {
    font-size: var(--text-step-3);
  }

  .work-row__link {
    text-decoration: none;
  }

  .work-row__summary {
    max-width: 52ch;
    color: var(--ink-muted);
  }

  .work-row__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: auto;
    padding-block-start: 0.75rem;
  }

  .work-row__arrow {
    position: absolute;
    top: 1.4rem;
    right: 1.5rem;
    color: var(--ink-faint);
    transition:
      translate var(--duration-base) var(--ease-out-expo),
      color var(--duration-fast) ease;
  }

  .work-row:hover .work-row__arrow {
    translate: 3px -3px;
    color: var(--ink);
  }

  @media (width < 44rem) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
