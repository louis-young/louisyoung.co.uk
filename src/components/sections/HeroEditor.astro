---
import { cv } from "../../../content/data/cv";
import { profile } from "../../../content/data/profile";
import { translatorFor } from "../../i18n/astro";
import { filled, withoutPlaceholders } from "../../lib/placeholders";

/**
 * A decorative editor that types out a few lines of TypeScript about Louis. Every value comes
 * from content/data, so it never says anything the rest of the site doesn't. Pure CSS: each
 * line is an inline-block whose width steps from 0 to its length in `ch`, one character at a
 * time, after the lines before it. With reduced motion it is simply finished.
 */
type Kind = "keyword" | "string" | "type" | "name" | "plain" | "comment" | "call";
type Token = readonly [Kind, string];

const t = translatorFor(Astro);
const quote = (value: string): Token => ["string", `"${value}"`];
const skills = withoutPlaceholders([...new Set(cv.skills.flatMap((group) => group.items))]);
const stack = [
  ...skills.filter((skill) => profile.intro.includes(skill)),
  ...skills.filter((skill) => !profile.intro.includes(skill)),
].slice(0, 3);
const field = (key: string, value: Token[]): Token[] => [
  ["plain", "  "],
  ["name", key],
  ["plain", ": "],
  ...value,
  ["plain", ","],
];
const motto = profile.principles[0]?.title;

const lines: Token[][] = [
  [
    ["keyword", "import type"],
    ["plain", " { "],
    ["type", "Engineer"],
    ["plain", " } "],
    ["keyword", "from"],
    ["plain", " "],
    quote("./people"),
    ["plain", ";"],
  ],
  [],
  [
    ["keyword", "export const"],
    ["plain", " "],
    ["name", "louis"],
    ["plain", " = {"],
  ],
  field("name", [quote(profile.name)]),
  field("role", [quote(profile.headline)]),
  ...(filled(profile.location.country) ? [field("based", [quote(profile.location.country)])] : []),
  field("stack", [
    ["plain", "["],
    ...stack.flatMap((skill, index): Token[] => [...(index > 0 ? [["plain", ", "] as const] : []), quote(skill)]),
    ["plain", "]"],
  ]),
  field("available", [["type", String(profile.availability.status === "available")]]),
  [
    ["plain", "} "],
    ["keyword", "satisfies"],
    ["plain", " "],
    ["type", "Engineer"],
    ["plain", ";"],
  ],
  ...(motto
    ? [
        [],
        [
          ["name", "louis"],
          ["plain", "."],
          ["call", "ship"],
          ["plain", "(); "],
          ["comment", `// ${motto}`],
        ] as Token[],
      ]
    : []),
];

/** Milliseconds per character, the pause between lines and the wait before typing starts. */
const perChar = 13;
const pause = 70;
let clock = 700;
const typed = lines.map((tokens) => {
  const length = tokens.reduce((total, [, text]) => total + text.length, 0);
  const start = clock;
  clock += length * perChar + pause;
  return { tokens, length, start, duration: length * perChar };
});
const done = clock;
---

<div class="editor" aria-hidden="true">
  <div class="editor__window card">
    <div class="editor__bar">
      <span class="editor__lights">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class="editor__tab">
        <span class="editor__badge">TS</span>louis.ts
      </span>
    </div>
    <div class="editor__code">
      {typed.map(({ tokens, length, start, duration }, index) => (
        <div class="editor__line" style={`--n: ${length}; --d: ${start}ms; --t: ${duration}ms`}>
          <span class="editor__number">{index + 1}</span>
          {length > 0 && (
            <span class:list={["editor__text", { "editor__text--last": index === typed.length - 1 }]}>
              {tokens.map(([kind, text]) => (
                <span class={`editor__${kind}`}>{text}</span>
              ))}
            </span>
          )}
        </div>
      ))}
    </div>
    <div class="editor__status" style={`--d: ${done}ms`}>
      <span>main</span>
      <span class="editor__ok">✓ {t("home.editorProblems")}</span>
      <span class="editor__lang">TypeScript</span>
    </div>
  </div>
</div>

<style>
  .editor {
    position: relative;
    perspective: 2000px;
  }

  /* Two soft glows behind the window, so it sits in light rather than on the page. */
  .editor::before {
    content: "";
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    background:
      radial-gradient(closest-side at 30% 40%, var(--glow-1), transparent),
      radial-gradient(closest-side at 75% 70%, var(--glow-2), transparent);
    filter: blur(24px);
  }

  .editor__window {
    overflow: hidden;
    border-color: var(--rule-strong);
    background: var(--paper-sunken);
    box-shadow:
      var(--shadow-raised),
      0 40px 80px -40px color-mix(in oklch, var(--accent) 45%, transparent);
    transform: rotateY(-5deg) rotateX(2deg);
    transform-origin: 0 50%;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .editor:hover .editor__window {
    transform: none;
  }

  /* A hairline of light along the top edge. */
  .editor__window::after {
    content: "";
    position: absolute;
    inset: 0 10% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.7;
  }

  .editor__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-block-end: 1px solid var(--rule);
    background: var(--paper-raised);
  }

  .editor__lights {
    display: flex;
    gap: 0.4rem;
  }

  .editor__lights span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  .editor__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--ink-muted);
  }

  .editor__badge {
    padding: 0.2rem 0.25rem;
    border-radius: 0.25rem;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .editor__code {
    padding: 1.1rem 1.25rem 1.1rem 0.75rem;
    font: 400 0.8125rem / 1.75 var(--mono);
    font-variant-ligatures: none;
    color: var(--ink);
  }

  .editor__line {
    display: flex;
    white-space: pre;
  }

  .editor__number {
    flex: none;
    width: 2ch;
    margin-inline-end: 1.25rem;
    text-align: end;
    color: var(--ink-faint);
  }

  .editor__text {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .editor__keyword {
    color: var(--accent);
  }

  .editor__string {
    color: var(--syntax-string);
  }

  .editor__type,
  .editor__call {
    color: var(--syntax-type);
  }

  .editor__comment {
    color: var(--ink-faint);
    font-style: italic;
  }

  .editor__status {
    display: flex;
    gap: 1rem;
    padding: 0.45rem 1rem;
    border-block-start: 1px solid var(--rule);
    background: var(--paper-raised);
    font: 500 var(--text-step--2) / 1.4 var(--mono);
    color: var(--ink-muted);
  }

  .editor__ok {
    color: var(--syntax-string);
  }

  .editor__lang {
    margin-inline-start: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .editor__text {
      /* Content-box width plus a 2px caret that only shows while this line is typing. */
      width: calc(var(--n) * 1ch);
      border-inline-end: 2px solid transparent;
      animation:
        type var(--t) steps(var(--n), end) var(--d) backwards,
        caret var(--t) linear var(--d);
    }

    .editor__text--last {
      animation:
        type var(--t) steps(var(--n), end) var(--d) backwards,
        blink 1.1s steps(1) var(--d) 4;
    }

    .editor__number,
    .editor__status > * {
      animation: appear 1ms var(--d) backwards;
    }

    .editor__window {
      animation: float-in 1.2s var(--ease-out-expo) 200ms backwards;
    }
  }

  @keyframes type {
    from {
      width: 0;
    }
  }

  @keyframes caret {
    from,
    to {
      border-color: var(--accent);
    }
  }

  @keyframes blink {
    0% {
      border-color: var(--accent);
    }
    50% {
      border-color: transparent;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: rotateY(-18deg) rotateX(8deg) translateY(2rem);
    }
  }

  @media (forced-colors: active) {
    .editor::before,
    .editor__window::after {
      display: none;
    }

    .editor__window {
      transform: none;
    }

    /* Forced colours paint every border, transparent or not, so the caret goes. */
    .editor__text {
      border-inline-end: 0;
    }
  }
</style>
