---
import { render, type CollectionEntry } from "astro:content";

import { formatDate, isoDate, useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { isPagePublished } from "../../lib/work";
import Callout from "../mdx/Callout.astro";
import PageHero from "./PageHero.astro";

interface Props {
  page: CollectionEntry<"pages">;
  label: string;
}

const { page, label } = Astro.props;
const { Content } = await render(page);
const locale = localeOf(Astro);
const t = useTranslations(locale);
const published = isPagePublished(page);
---

<Base
  title={page.data.title}
  description={page.data.description}
  image={published ? `/og/${page.id}.png` : undefined}
  noindex={!published}
>
  {published ? (
    <>
      <PageHero label={label} title={page.data.title} lede={page.data.summary} narrow>
        <p class="label">
          <time datetime={isoDate(page.data.updated)}>
            {t("page.updated", { date: formatDate(page.data.updated, locale) })}
          </time>
        </p>
      </PageHero>
      <div class="container-text mdx-page prose" data-pagefind-body>
        <Content components={{ Callout }} />
      </div>
      <slot />
    </>
  ) : (
    <PageHero label={label} title={page.data.title} lede={t("page.draft")} narrow>
      <a href="/" class="button button--small">
        <span aria-hidden="true">←</span> {t("nav.home")}
      </a>
      <a href="/writing/" class="button button--small">
        {t("nav.writing")}
      </a>
    </PageHero>
  )}
</Base>

<style>
  .mdx-page {
    padding-block: 2.5rem var(--spacing-section);
    border-block-start: 1px solid var(--rule);
  }
</style>
