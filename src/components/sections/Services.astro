---
import { hire } from "../../../content/data/hire";
import { filled, withoutPlaceholders } from "../../lib/placeholders";

interface Props {
  /** Show each service's bullet-point details, as on `/hire/`. */
  detailed?: boolean;
  headingLevel?: "h2" | "h3";
}

const { detailed = false, headingLevel: Heading = "h3" } = Astro.props;
const icons = ["◇", "◎", "△", "□"];
---

<ul class="services" role="list">
  {hire.services.map((service, index) => (
    <li class="service card" id={`service-${service.id}`}>
      <span class="service__icon" aria-hidden="true">
        {icons[index % icons.length]}
      </span>
      <Heading class="service__name">{service.name}</Heading>
      <p class="service__summary">{service.summary}</p>
      {detailed && (
        <ul class="service__details" role="list">
          {withoutPlaceholders(service.details).map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
      )}
      {filled(service.price) && <p class="service__price">{service.price}</p>}
    </li>
  ))}
</ul>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1.1rem;
  }

  .service__name {
    font-size: var(--text-step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .service__summary {
    color: var(--ink-muted);
  }

  .service__details {
    display: grid;
    gap: 0.4rem;
    font-size: var(--text-step--1);
    color: var(--ink-muted);
  }

  .service__details li {
    display: flex;
    gap: 0.5rem;
  }

  .service__details li::before {
    content: "✓";
    color: var(--success);
  }

  .service__price {
    margin-block-start: auto;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--rule);
    font: 500 var(--text-step--1) / 1.3 var(--mono);
    color: var(--ink);
  }
</style>
