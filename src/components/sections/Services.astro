---
import { hire } from "../../../content/data/hire";

interface Props {
  /** Show each service's bullet-point details, as on `/hire/`. */
  detailed?: boolean;
  headingLevel?: "h2" | "h3";
}

const { detailed = false, headingLevel: Heading = "h3" } = Astro.props;
const letters = "ABCDEFGH";
---

<ol class="services" role="list">
  {hire.services.map((service, index) => (
    <li class="service" id={`service-${service.id}`}>
      <p class="service__letter" aria-hidden="true">
        {letters[index]}
      </p>
      <Heading class="service__name">{service.name}</Heading>
      <p class="service__summary">{service.summary}</p>
      {detailed && (
        <ul class="service__details" role="list">
          {service.details.map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
      )}
      <p class="service__price">{service.price}</p>
    </li>
  ))}
</ol>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-block-start: 2px solid currentColor;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.75rem 2rem;
    border-inline-end: 2px solid currentColor;
  }

  .service:first-child {
    padding-inline-start: 0;
  }

  .service:last-child {
    padding-inline-end: 0;
    border-inline-end: 0;
  }

  .service__letter {
    font: 500 var(--text-step--1) / 1 var(--mono);
  }

  .service__name {
    font-weight: 800;
    font-size: var(--text-step-2);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .service__summary {
    line-height: 1.5;
  }

  .service__details {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-step--1);
  }

  .service__details li::before {
    content: "— ";
  }

  .service__price {
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    font: 500 var(--text-step--1) / 1.3 var(--mono);
  }

  @media (width < 54rem) {
    .service,
    .service:first-child,
    .service:last-child {
      padding-inline: 0;
      border-inline-end: 0;
      border-block-end: 2px solid currentColor;
    }

    .service:last-child {
      border-block-end: 0;
    }
  }
</style>
