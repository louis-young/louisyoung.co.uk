---
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import { getSnippets } from "../../lib/snippets";
import { featuredTools, toolPath, tools } from "../../lib/tool-catalogue";
import SectionHeading from "./SectionHeading.astro";
import Shortcuts from "./Shortcuts.astro";

/** The developer-facing corner of the site: tools, snippets and the keyboard. Counts come from the catalogue and the collection. */
const t = useTranslations(localeOf(Astro));
const snippets = await getSnippets();
const featured = featuredTools().map((tool) => ({
  href: toolPath(tool.slug),
  title: t(tool.title),
  summary: t(tool.summary),
  icon: tool.icon,
}));
---

<section class="container-page teaser" aria-labelledby="tools-title">
  <SectionHeading id="tools-title" number={t("nav.tools")} title={t("home.toolsTitle")} />
  <div class="teaser__grid">
    <div class="card teaser__intro rise">
      <div class="teaser__glow" aria-hidden="true"></div>
      <p class="teaser__counts">
        <span class="teaser__count">{t("home.toolsCount", { count: tools.length })}</span>
        {snippets.length > 0 && <span class="teaser__count">{t("snippets.count", { count: snippets.length })}</span>}
      </p>
      <p class="teaser__lede">{t("home.toolsIntro")}</p>
      <div class="teaser__actions">
        <a href="/tools/" class="button button--primary button--small">
          {t("home.allTools")} <span aria-hidden="true">→</span>
        </a>
        {snippets.length > 0 && (
          <a href="/snippets/" class="button button--small">
            {t("snippets.all")}
          </a>
        )}
      </div>
    </div>
    <ul class="teaser__tools" role="list" aria-label={t("home.featuredTools")}>
      {featured.map((tool) => (
        <li class="teaser__tool card card--interactive rise">
          <span class="teaser__icon" aria-hidden="true">
            {tool.icon}
          </span>
          <h3 class="teaser__title">
            <a href={tool.href} class="stretched-link">
              {tool.title}
            </a>
          </h3>
          <p class="teaser__summary">{tool.summary}</p>
        </li>
      ))}
    </ul>
  </div>
  <Shortcuts class="teaser__keys rise" />
</section>

<style>
  .teaser {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .teaser__grid {
    display: grid;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  @media (width >= 56rem) {
    .teaser__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .teaser__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    overflow: hidden;
  }

  .teaser__glow {
    position: absolute;
    inset: auto auto -45% -25%;
    width: 75%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow-2), transparent);
    pointer-events: none;
  }

  .teaser__counts {
    display: grid;
    gap: 0.1rem;
  }

  .teaser__count {
    font-weight: 600;
    font-size: var(--text-step-4);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }

  .teaser__count + .teaser__count {
    color: var(--ink-faint);
  }

  .teaser__lede {
    max-width: 40ch;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .teaser > :global(.teaser__keys) {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  /* Touch-only devices have no keyboard to light up, so the shortcuts would only add length. */
  @media (hover: none) and (pointer: coarse) {
    .teaser > :global(.teaser__keys) {
      display: none;
    }
  }

  .teaser__tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (width >= 40rem) {
    .teaser__tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (width >= 56rem) {
    .teaser__tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 68rem) {
    .teaser__tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .teaser__tool {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .teaser__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-block-end: 0.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--accent) 10%, transparent);
    color: var(--accent);
    font: 600 var(--text-step--1) / 1 var(--sans);
    white-space: nowrap;
  }

  .teaser__title {
    font-weight: 600;
    font-size: var(--text-step-0);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .teaser__title a {
    text-decoration: none;
  }

  .teaser__tool:hover .teaser__title a {
    color: var(--accent);
  }

  .teaser__summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
    line-height: 1.45;
  }

  /* Phones: two tiles a row leaves room for the icon and the name, not the summary. */
  @media (width < 40rem) {
    .teaser__summary {
      display: none;
    }
  }
</style>
