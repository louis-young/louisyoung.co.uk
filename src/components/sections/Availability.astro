---
import { profile } from "../../../content/data/profile";
import { translatorFor } from "../../i18n/astro";
import { filled } from "../../lib/placeholders";

const t = translatorFor(Astro);
const { status, from } = profile.availability;
const date = filled(from);
const labels = {
  available: date ? t("availability.available", { date }) : t("availability.open"),
  limited: date ? t("availability.limited", { date }) : t("availability.limitedOpen"),
  unavailable: t("availability.unavailable"),
};
---

<a href="/hire/" class:list={["chip", `chip--${status}`]}>
  <span class="chip__dot" aria-hidden="true"></span>
  {labels[status]}
</a>

<style>
  .chip:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .chip--limited :global(.chip__dot) {
    background: var(--warning);
  }

  .chip--unavailable :global(.chip__dot) {
    background: var(--ink-faint);
  }
</style>
