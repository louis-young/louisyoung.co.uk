---
import { cv } from "../../../content/data/cv";
import { withoutPlaceholders } from "../../lib/placeholders";

const items = withoutPlaceholders([...new Set(cv.skills.flatMap((group) => group.items))]);
---

<ul class="toolbox" role="list">
  {items.map((item) => (
    <li class="tag">{item}</li>
  ))}
</ul>

<style>
  .toolbox {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
