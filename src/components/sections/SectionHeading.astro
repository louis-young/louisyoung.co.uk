---
interface Props {
  /** Small mono label above the title, e.g. "Writing". */
  number?: string | undefined;
  title: string;
  id: string;
  level?: "h1" | "h2";
  link?: { href: string; label: string; download?: boolean } | undefined;
}

const { number, title, id, level: Heading = "h2", link } = Astro.props;
---

<div class="section-heading">
  <div>
    {number && (
      <p class="label section-heading__eyebrow" aria-hidden="true">
        {number}
      </p>
    )}
    <Heading id={id} class="section-title">
      {title}
    </Heading>
  </div>
  {link && (
    <a href={link.href} class="section-heading__link" download={link.download ? "" : undefined}>
      {link.label} <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-block-end: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .section-heading__eyebrow {
    margin-block-end: 0.6rem;
    color: var(--accent);
  }

  .section-heading__link {
    font-size: var(--text-step--1);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .section-heading__link:hover {
    color: var(--ink);
  }

  .section-heading__link span {
    display: inline-block;
    transition: translate var(--duration-base) var(--ease-out-expo);
  }

  .section-heading__link:hover span {
    translate: 3px 0;
  }
</style>
