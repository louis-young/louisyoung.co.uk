---
interface Props {
  label: string;
  title: string;
  lede?: string | undefined;
  /** Narrow pages (articles, /now) align with the text column. */
  narrow?: boolean;
}

const { label, title, lede, narrow = false } = Astro.props;
---

<header class:list={["page-hero", narrow ? "container-text" : "container-page"]}>
  <p class="label page-hero__label reveal">{label}</p>
  <h1 class="page-title reveal" style="--reveal-index: 1">
    {title}
  </h1>
  {lede && (
    <p class="page-lede page-hero__lede reveal" style="--reveal-index: 2">
      {lede}
    </p>
  )}
  {Astro.slots.has("default") && (
    <div class="page-hero__actions reveal" style="--reveal-index: 3">
      <slot />
    </div>
  )}
</header>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .page-hero__label {
    margin-block-end: 1rem;
    color: var(--accent);
  }

  .page-hero__lede {
    margin-block-start: 1.25rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: 2rem;
  }
</style>
