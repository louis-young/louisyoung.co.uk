---
import PageHero from "../../components/sections/PageHero.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { toolPageProps } from "../../lib/tool-catalogue";
import { hashAlgorithms, uuidLimits } from "../../lib/hash-tool";

const t = useTranslations(localeOf(Astro));
const kinds = [
  { kind: "hex", label: t("tools.hash.hex") },
  { kind: "base64", label: t("tools.hash.base64") },
];
---

<Base {...toolPageProps("hash", t)}>
  <PageHero label={t("nav.tools")} title={t("tools.hash.title")} lede={t("tools.hash.summary")} />
  <div class="container-page hash" data-hash data-copied={t("tools.copied")}>
    <p class="hash__warning" role="alert" data-unsupported hidden>
      {t("tools.hash.unsupported")}
    </p>
    <div class="hash__input card">
      <label class="hash__label" for="hash-input">
        {t("tools.hash.input")}
      </label>
      <textarea
        id="hash-input"
        class="hash__area"
        rows="5"
        spellcheck="false"
        autocomplete="off"
        aria-describedby="hash-hint"
        data-input
      >{t("tools.hash.sample")}</textarea>
      <div class="hash__options">
        <p id="hash-hint" class="hash__hint">
          {t("tools.hash.hint")}
        </p>
        <label class="hash__check">
          <input type="checkbox" data-uppercase />
          <span>{t("tools.hash.uppercase")}</span>
        </label>
      </div>
    </div>

    <section class="hash__card card" aria-labelledby="hash-hashes">
      <h2 id="hash-hashes" class="label">
        {t("tools.hash.hashes")}
      </h2>
      <div class="hash__list" aria-live="polite">
        {hashAlgorithms.map((algorithm) => (
          <div class="hash__item" data-algorithm={algorithm}>
            <h3 class="hash__name">{algorithm}</h3>
            {algorithm === "SHA-1" && <p class="hash__note">{t("tools.hash.weak")}</p>}
            <dl class="hash__values">
              {kinds.map((item) => (
                <div class="hash__value">
                  <dt>{item.label}</dt>
                  <dd>
                    <code data-value={item.kind} />
                    <button type="button" class="button button--small" data-copy={`${algorithm} ${item.kind}`}>
                      <span data-copy-label>{t("tools.copy")}</span>
                      <span class="visually-hidden">
                        {algorithm} {item.label}
                      </span>
                    </button>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section class="hash__card card" aria-labelledby="hash-uuids">
      <h2 id="hash-uuids" class="label">
        {t("tools.hash.uuids")}
      </h2>
      <div class="hash__controls">
        <label class="hash__count">
          <span class="hash__label">{t("tools.hash.count")}</span>
          <input
            type="number"
            value="5"
            min={uuidLimits.min}
            max={uuidLimits.max}
            step="1"
            inputmode="numeric"
            data-count
          />
        </label>
        <button type="button" class="button button--primary" data-generate>
          {t("tools.hash.generate")}
        </button>
        <button type="button" class="button" data-copy-all>
          <span data-copy-label>{t("tools.hash.copyAll")}</span>
        </button>
      </div>
      <ol class="hash__uuids" role="list" aria-live="polite" data-uuids></ol>
    </section>
  </div>
</Base>

<script>
  import { initHash } from "../../scripts/tool-hash";

  initHash();
</script>

<style>
  .hash {
    display: grid;
    gap: 1rem;
    padding-block-end: var(--spacing-section);
  }

  .hash .card {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .hash__label {
    font-weight: 500;
    font-size: var(--text-step--1);
  }

  .hash__area {
    width: 100%;
    min-width: 0;
    min-height: 7rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: 400 var(--text-step--1) / 1.6 var(--mono);
    resize: vertical;
  }

  .hash__options {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  .hash__hint {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .hash__check {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .hash__check input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
  }

  .hash__area:focus-visible,
  .hash__check input:focus-visible,
  .hash__count input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hash__warning {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--warning-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
  }

  .hash__list {
    display: grid;
    gap: 0;
  }

  .hash__item {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    padding-block: 1rem;
    border-block-start: 1px solid var(--rule);
  }

  .hash__item:first-child {
    padding-block-start: 0.25rem;
    border-block-start: 0;
  }

  .hash__name {
    font-weight: 600;
    font-size: var(--text-step-0);
  }

  .hash__note {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .hash__values {
    display: grid;
    gap: 0.4rem;
  }

  .hash__value {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .hash__value dt {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .hash__value dd {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .hash__value code,
  .hash__uuids :global(code) {
    flex: 1;
    min-width: 0;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    font: 400 var(--text-step--1) / 1.5 var(--mono);
    overflow-wrap: anywhere;
  }

  .hash__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
  }

  .hash__count {
    display: grid;
    gap: 0.4rem;
  }

  .hash__count input {
    width: 7rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: 500 var(--text-step--1) / 1 var(--mono);
  }

  .hash__uuids {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0.5rem;
  }

  .hash__uuids :global(li) {
    display: flex;
    min-width: 0;
  }

  @media (width < 36rem) {
    .hash__value {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }
  }
</style>
