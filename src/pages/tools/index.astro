---
import PageHero from "../../components/sections/PageHero.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { breadcrumbSchema, itemListSchema } from "../../lib/seo";
import { toolPath, tools } from "../../lib/tool-catalogue";

const t = useTranslations(localeOf(Astro));
const list = tools.map((tool) => ({
  href: toolPath(tool.slug),
  title: t(tool.title),
  summary: t(tool.summary),
  icon: tool.icon,
}));
const schema = [
  itemListSchema({
    name: t("tools.heading"),
    description: t("tools.description"),
    path: "/tools/",
    items: list.map((tool) => ({ name: tool.title, path: tool.href })),
  }),
  breadcrumbSchema([{ name: t("nav.tools"), path: "/tools/" }]),
];
---

<Base title={t("tools.title")} description={t("tools.description")} image="/og/tools.png" schema={schema}>
  <PageHero label={t("nav.tools")} title={t("tools.heading")} lede={t("tools.lede")} />
  <section class="container-page tools" aria-label={t("tools.title")}>
    <ul class="tools__grid" role="list">
      {list.map((tool) => (
        <li class="tool card card--interactive">
          <span class="tool__icon" aria-hidden="true">
            {tool.icon}
          </span>
          <h2 class="tool__title">
            <a href={tool.href} class="stretched-link">
              {tool.title}
            </a>
          </h2>
          <p class="tool__summary">{tool.summary}</p>
          <span class="tool__cta" aria-hidden="true">
            {t("tools.open")} →
          </span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .tools {
    padding-block-end: var(--spacing-section);
  }

  .tools__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }

  .tool {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem;
  }

  .tool__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-block-end: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--accent) 10%, transparent);
    color: var(--accent);
    font: 600 var(--text-step-0) / 1 var(--sans);
  }

  .tool__title {
    font-weight: 600;
    font-size: var(--text-step-1);
    letter-spacing: -0.02em;
  }

  .tool__title a {
    text-decoration: none;
  }

  .tool__summary {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .tool__cta {
    margin-block-start: 0.5rem;
    color: var(--accent);
    font-size: var(--text-step--1);
    font-weight: 500;
  }
</style>
