---
import PageHero from "../../components/sections/PageHero.astro";
import ShareLink from "../../components/ShareLink.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { MAX_EXPANSIONS, matchPaths } from "../../lib/glob-tool";
import { toolPageProps } from "../../lib/tool-catalogue";

const t = useTranslations(localeOf(Astro));
const pattern = "src/**/*.{ts,tsx}";
const paths = [
  "src/index.ts",
  "src/components/Button.tsx",
  "src/components/Button.test.tsx",
  "src/styles/global.css",
  "src/.cache/build.ts",
  "test/setup.ts",
  "README.md",
].join("\n");
// The default results are rendered here too, so the page doesn't shift when the script fills them in.
const initial = matchPaths(pattern, paths);
const matched = initial.matches.filter((match) => match.matched).length;
---

<Base {...toolPageProps("glob", t)}>
  <PageHero label={t("nav.tools")} title={t("tools.glob.title")} lede={t("tools.glob.summary")}>
    <ShareLink />
  </PageHero>
  <div
    class="container-page glob"
    data-glob
    data-copied={t("tools.copied")}
    data-match-count={t("tools.glob.matchCount")}
    data-no-paths={t("tools.glob.noPaths")}
    data-empty={t("tools.glob.empty")}
    data-too-many={t("tools.glob.tooMany").replace("{max}", MAX_EXPANSIONS.toLocaleString("en-GB"))}
    data-match={t("tools.glob.match")}
    data-no-match={t("tools.glob.noMatch")}
    data-expanded={t("tools.glob.expanded")}
    data-part-globstar={t("tools.glob.globstar")}
    data-part-star={t("tools.glob.star")}
    data-part-star-only={t("tools.glob.starOnly")}
    data-part-qmark={t("tools.glob.qmark")}
    data-part-class={t("tools.glob.class")}
    data-part-class-negated={t("tools.glob.classNegated")}
    data-part-braces={t("tools.glob.braces")}
    data-part-literal={t("tools.glob.literal")}
    data-or={t("tools.glob.or")}
    data-then={t("tools.glob.then")}
    data-root={t("tools.glob.root")}
    data-hidden={t("tools.glob.hidden")}
  >
    <div class="glob__input card">
      <label class="glob__label" for="glob-pattern">
        {t("tools.glob.pattern")}
      </label>
      <input
        id="glob-pattern"
        class="glob__field"
        type="text"
        value={pattern}
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        aria-describedby="glob-pattern-hint glob-status"
        data-pattern
        data-share="pattern"
      />
      <p id="glob-pattern-hint" class="glob__hint">
        {t("tools.glob.patternHint")}
      </p>
      <fieldset class="glob__options">
        <legend class="glob__label">{t("tools.glob.options")}</legend>
        <label class="glob__check">
          <input type="checkbox" data-dot data-share="dot" />
          <span>{t("tools.glob.dot")}</span>
        </label>
        <label class="glob__check">
          <input type="checkbox" data-nocase data-share="nocase" />
          <span>{t("tools.glob.nocase")}</span>
        </label>
      </fieldset>
      <label class="glob__label" for="glob-paths">
        {t("tools.glob.paths")}
      </label>
      <textarea
        id="glob-paths"
        class="glob__area"
        rows="9"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        data-paths
        data-share="paths"
      >{paths}</textarea>
    </div>

    <div class="glob__output">
      <section class="glob__card card" aria-labelledby="glob-results">
        <h2 id="glob-results" class="label">
          {t("tools.glob.results")}
        </h2>
        <p id="glob-status" class="glob__status" role="status" data-status>
          {t("tools.glob.matchCount", { matched, total: initial.matches.length })}
        </p>
        <ul class="glob__list" role="list" data-list>
          {initial.matches.map((match) => (
            <li data-matched={match.matched ? "" : undefined}>
              <code>{match.path}</code>
              <span class="glob__badge">{t(match.matched ? "tools.glob.match" : "tools.glob.noMatch")}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="glob__card card" aria-labelledby="glob-regex">
        <div class="glob__head">
          <h2 id="glob-regex" class="label">
            {t("tools.glob.regex")}
          </h2>
          <button type="button" class="button button--small" data-copy-regex>
            <span data-copy-label>{t("tools.copy")}</span>
            <span class="visually-hidden">{t("tools.glob.regex")}</span>
          </button>
        </div>
        <code class="glob__regex" data-regex>
          {initial.result.ok ? String(initial.result.regex) : ""}
        </code>
        <p class="glob__note" data-negated hidden>
          {t("tools.glob.negated")}
        </p>
        <p class="glob__note" data-expanded-note hidden></p>
      </section>

      <section class="glob__card card" aria-labelledby="glob-explain">
        <h2 id="glob-explain" class="label">
          {t("tools.glob.explain")}
        </h2>
        <ol class="glob__segments" role="list" data-segments></ol>
      </section>
    </div>
  </div>
</Base>

<script>
  import { initGlob } from "../../scripts/tool-glob";
  import { initShareLink } from "../../scripts/share-link";

  initGlob();
  initShareLink();
</script>

<style>
  .glob {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
    padding-block-end: var(--spacing-section);
  }

  .glob .card {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .glob__output {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .glob__label {
    font-weight: 500;
    font-size: var(--text-step--1);
  }

  .glob__field,
  .glob__area {
    width: 100%;
    min-width: 0;
    padding: 0.7rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: 400 var(--text-step--1) / 1.6 var(--mono);
  }

  .glob__field {
    min-height: 2.75rem;
    font-weight: 500;
  }

  .glob__area {
    min-height: 14rem;
    white-space: pre;
    overflow-x: auto;
    resize: vertical;
  }

  .glob__field[aria-invalid="true"] {
    border-color: var(--danger);
  }

  .glob__hint,
  .glob__note {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .glob__note[hidden] {
    display: none;
  }

  .glob__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Floating the legend lays it out inside the fieldset rather than across its border. */
  .glob__options > legend {
    float: left;
    width: 100%;
    padding: 0;
  }

  .glob__check {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .glob__check input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .glob__field:focus-visible,
  .glob__area:focus-visible,
  .glob__check input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .glob__status {
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
    overflow-wrap: anywhere;
  }

  .glob__status[data-invalid] {
    background: var(--warning-soft);
  }

  .glob__list {
    display: grid;
    gap: 0.35rem;
  }

  .glob__list :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
  }

  .glob__list :global(li[data-matched]) {
    border-color: var(--success);
    box-shadow: inset 3px 0 0 var(--success);
  }

  .glob__list :global(code) {
    min-width: 0;
    font: 500 var(--text-step--1) / 1.5 var(--mono);
    overflow-wrap: anywhere;
  }

  .glob__list :global(li:not([data-matched]) code) {
    color: var(--ink-muted);
  }

  .glob__list :global(.glob__badge) {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--paper-sunken);
    color: var(--ink-muted);
    font: 600 var(--text-step--2) / 1.2 var(--mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .glob__list :global(li[data-matched] .glob__badge) {
    background: var(--success-soft);
    color: var(--ink);
  }

  .glob__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .glob__regex {
    display: block;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--syntax-type);
    font: 500 var(--text-step--1) / 1.6 var(--mono);
    overflow-wrap: anywhere;
  }

  .glob__segments {
    display: grid;
    gap: 0.5rem;
  }

  .glob__segments :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1rem;
    min-width: 0;
    padding-block: 0.5rem;
    border-block-start: 1px solid var(--rule);
    font-size: var(--text-step--1);
  }

  .glob__segments :global(li:first-child) {
    border-block-start: 0;
  }

  .glob__segments :global(code) {
    justify-self: start;
    max-width: 100%;
    padding: 0.2rem 0.5rem;
    border-radius: 0.3rem;
    background: var(--paper-sunken);
    color: var(--syntax-string);
    font: 600 var(--text-step--1) / 1.4 var(--mono);
    overflow-wrap: anywhere;
  }

  .glob__segments :global(.glob__hidden) {
    grid-column: 2;
    color: var(--ink-muted);
  }

  @media (width < 56rem) {
    .glob {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 34rem) {
    .glob__segments :global(li) {
      grid-template-columns: minmax(0, 1fr);
    }

    .glob__segments :global(.glob__hidden) {
      grid-column: 1;
    }
  }
</style>
