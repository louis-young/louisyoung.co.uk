---
import PageHero from "../../components/sections/PageHero.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { type CaseName, convertAll } from "../../lib/case-tool";
import { toolPageProps } from "../../lib/tool-catalogue";

const t = useTranslations(localeOf(Astro));
const sample = "parseHTTPResponse\nCrème brûlée for 2";
const converted = convertAll(sample);
const cases: { name: CaseName; label: string }[] = [
  { name: "camel", label: t("tools.case.camel") },
  { name: "pascal", label: t("tools.case.pascal") },
  { name: "snake", label: t("tools.case.snake") },
  { name: "screaming", label: t("tools.case.screaming") },
  { name: "kebab", label: t("tools.case.kebab") },
  { name: "title", label: t("tools.case.titleCase") },
  { name: "sentence", label: t("tools.case.sentence") },
  { name: "dot", label: t("tools.case.dot") },
  { name: "path", label: t("tools.case.path") },
  { name: "slug", label: t("tools.case.slug") },
];
---

<Base {...toolPageProps("case", t)}>
  <PageHero label={t("nav.tools")} title={t("tools.case.title")} lede={t("tools.case.summary")} />
  <div
    class="container-page case"
    data-case
    data-copied={t("tools.copied")}
    data-empty={t("tools.case.empty")}
    data-lines-one={t("tools.case.linesOne")}
    data-lines-other={t("tools.case.linesOther")}
  >
    <div class="case__input card">
      <label class="case__label" for="case-input">
        {t("tools.case.input")}
      </label>
      <textarea
        id="case-input"
        class="case__area"
        rows="6"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        aria-describedby="case-hint case-status"
        data-input
      >{sample}</textarea>
      <p id="case-hint" class="case__hint">
        {t("tools.case.hint")}
      </p>
      <p id="case-status" class="case__status" role="status" data-status></p>
    </div>

    <section class="case__results card" aria-labelledby="case-results">
      <h2 id="case-results" class="label">
        {t("tools.case.results")}
      </h2>
      <ul class="case__list" role="list">
        {cases.map(({ name, label }) => (
          <li class="case__item">
            <div class="case__meta">
              <h3 class="case__name">{label}</h3>
              <button type="button" class="button button--small" data-copy={name}>
                <span data-copy-label>{t("tools.copy")}</span>
                <span class="visually-hidden">{label}</span>
              </button>
            </div>
            <pre class="case__value" data-value={name}>{converted[name]}</pre>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  import { initCase } from "../../scripts/tool-case";

  initCase();
</script>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 1rem;
    align-items: start;
    padding-block-end: var(--spacing-section);
  }

  .case > .card {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .case__label {
    font-weight: 500;
    font-size: var(--text-step--1);
  }

  .case__area {
    width: 100%;
    min-width: 0;
    min-height: 12rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: 400 var(--text-step-0) / 1.6 var(--mono);
    resize: vertical;
  }

  .case__area:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .case__hint {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .case__status {
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
  }

  .case__list {
    display: grid;
  }

  .case__item {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    padding-block: 0.85rem;
    border-block-start: 1px solid var(--rule);
  }

  .case__item:first-child {
    padding-block-start: 0.25rem;
    border-block-start: 0;
  }

  .case__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .case__name {
    color: var(--ink-muted);
    font: 500 var(--text-step--1) / 1.3 var(--mono);
    letter-spacing: 0;
  }

  .case__value {
    min-width: 0;
    min-height: 2.5rem;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: 500 var(--text-step--1) / 1.5 var(--mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (width < 56rem) {
    .case {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
