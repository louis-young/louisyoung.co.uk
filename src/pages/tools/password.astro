---
import PageHero from "../../components/sections/PageHero.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { countLimits, passphraseLimits, passwordLimits } from "../../lib/password-tool";
import { toolPageProps } from "../../lib/tool-catalogue";

const t = useTranslations(localeOf(Astro));
const kinds = [
  { value: "password", label: t("tools.password.password") },
  { value: "passphrase", label: t("tools.password.passphrase") },
];
const sets = [
  { value: "lower", label: t("tools.password.lower") },
  { value: "upper", label: t("tools.password.upper") },
  { value: "digits", label: t("tools.password.digits") },
  { value: "symbols", label: t("tools.password.symbols") },
];
const separators = [
  { value: "-", label: t("tools.password.hyphen") },
  { value: " ", label: t("tools.password.space") },
  { value: ".", label: t("tools.password.dot") },
  { value: "_", label: t("tools.password.underscore") },
  { value: "", label: t("tools.password.none") },
];
const capitalisations = [
  { value: "lower", label: t("tools.password.lowerWords") },
  { value: "title", label: t("tools.password.titleWords") },
  { value: "upper", label: t("tools.password.upperWords") },
];
---

<Base {...toolPageProps("password", t)}>
  {/* No share link here, on purpose: secrets never go in a URL. */}
  <PageHero label={t("nav.tools")} title={t("tools.password.title")} lede={t("tools.password.summary")} />
  <div
    class="container-page pw"
    data-password
    data-copy={t("tools.copy")}
    data-copied={t("tools.copied")}
    data-no-sets={t("tools.password.noSets")}
    data-item-password={t("tools.password.itemPassword")}
    data-item-passphrase={t("tools.password.itemPassphrase")}
    data-generated-password={t("tools.password.generatedPasswords")}
    data-generated-passphrase={t("tools.password.generatedPassphrases")}
    data-bits={t("tools.password.bits")}
    data-very-weak={t("tools.password.veryWeak")}
    data-weak={t("tools.password.weak")}
    data-fair={t("tools.password.fair")}
    data-strong={t("tools.password.strong")}
    data-very-strong={t("tools.password.veryStrong")}
    data-instant={t("tools.password.instant")}
    data-seconds={t("tools.password.seconds")}
    data-minutes={t("tools.password.minutes")}
    data-hours={t("tools.password.hours")}
    data-days={t("tools.password.days")}
    data-years={t("tools.password.years")}
    data-aeons={t("tools.password.aeons")}
  >
    <div class="pw__options card">
      <p class="pw__private">{t("tools.password.private")}</p>

      <fieldset class="pw__group">
        <legend class="pw__label">{t("tools.password.kind")}</legend>
        <div class="pw__segments">
          {kinds.map((kind, index) => (
            <label class="pw__segment">
              <input type="radio" name="pw-kind" value={kind.value} checked={index === 0} data-kind />
              <span>{kind.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pw__group" data-panel="password">
        <legend class="pw__label">{t("tools.password.options")}</legend>
        <div class="pw__range">
          <label class="pw__label" for="pw-length">
            {t("tools.password.length")}
          </label>
          <input
            id="pw-length"
            type="range"
            min={passwordLimits.min}
            max={passwordLimits.max}
            value="20"
            step="1"
            data-length
          />
          <output for="pw-length" class="pw__output" data-length-output>
            20
          </output>
        </div>
        <fieldset class="pw__group pw__group--nested">
          <legend class="pw__label">{t("tools.password.sets")}</legend>
          <div class="pw__checks">
            {sets.map((set) => (
              <label class="pw__check">
                <input type="checkbox" value={set.value} checked aria-describedby="pw-sets-hint" data-set />
                <span>{set.label}</span>
              </label>
            ))}
          </div>
          <p id="pw-sets-hint" class="pw__hint">
            {t("tools.password.setsHint")}
          </p>
        </fieldset>
        <label class="pw__check">
          <input type="checkbox" data-ambiguous />
          <span>{t("tools.password.ambiguous")}</span>
        </label>
      </fieldset>

      <fieldset class="pw__group" data-panel="passphrase" hidden>
        <legend class="pw__label">{t("tools.password.options")}</legend>
        <div class="pw__range">
          <label class="pw__label" for="pw-words">
            {t("tools.password.words")}
          </label>
          <input
            id="pw-words"
            type="range"
            min={passphraseLimits.min}
            max={passphraseLimits.max}
            value="5"
            step="1"
            aria-describedby="pw-wordlist"
            data-words
          />
          <output for="pw-words" class="pw__output" data-words-output>
            5
          </output>
        </div>
        <p id="pw-wordlist" class="pw__hint">
          {t("tools.password.wordlist")}
        </p>
        <div class="pw__fields">
          <div class="pw__field">
            <label class="pw__label" for="pw-separator">
              {t("tools.password.separator")}
            </label>
            <select id="pw-separator" class="pw__select" data-separator>
              {separators.map((separator) => (
                <option value={separator.value}>{separator.label}</option>
              ))}
            </select>
          </div>
          <div class="pw__field">
            <label class="pw__label" for="pw-capitalisation">
              {t("tools.password.capitalisation")}
            </label>
            <select id="pw-capitalisation" class="pw__select" data-capitalisation>
              {capitalisations.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        </div>
        <label class="pw__check">
          <input type="checkbox" data-digit />
          <span>{t("tools.password.digit")}</span>
        </label>
      </fieldset>

      <div class="pw__controls">
        <div class="pw__field">
          <label class="pw__label" for="pw-count">
            {t("tools.password.count")}
          </label>
          <input
            id="pw-count"
            class="pw__number"
            type="number"
            value="5"
            min={countLimits.min}
            max={countLimits.max}
            step="1"
            inputmode="numeric"
            data-count
          />
        </div>
        <button type="button" class="button button--primary" data-generate>
          {t("tools.password.generate")}
        </button>
      </div>
    </div>

    <section class="pw__results card" aria-labelledby="pw-results">
      <div class="pw__head">
        <h2 id="pw-results" class="label">
          {t("tools.password.results")}
        </h2>
        <button type="button" class="button button--small" data-copy-all>
          <span data-copy-label>{t("tools.password.copyAll")}</span>
        </button>
      </div>
      <p id="pw-status" class="pw__status" role="status" data-status></p>
      <div class="pw__meter" data-meter>
        <div class="pw__bar" aria-hidden="true">
          <span data-bar></span>
        </div>
        <dl class="pw__stats">
          <div>
            <dt>{t("tools.password.entropy")}</dt>
            <dd data-entropy></dd>
          </div>
          <div>
            <dt>{t("tools.password.time")}</dt>
            <dd data-time></dd>
          </div>
          <div class="pw__wide">
            <dt>{t("tools.password.strength")}</dt>
            <dd data-rating></dd>
          </div>
        </dl>
        <p class="pw__hint">{t("tools.password.timeHint")}</p>
      </div>
      <ol class="pw__list" role="list" data-list></ol>
    </section>
  </div>
</Base>

<script>
  import { initPassword } from "../../scripts/tool-password";

  initPassword();
</script>

<style>
  .pw {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
    padding-block-end: var(--spacing-section);
  }

  .pw > .card {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .pw__private {
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--success-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
  }

  .pw__label {
    font-weight: 500;
    font-size: var(--text-step--1);
  }

  .pw__hint {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .pw__group {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
    margin: 0;
    padding: 1.1rem 0 0;
    border: 0;
    border-block-start: 1px solid var(--rule);
  }

  .pw__group[hidden] {
    display: none;
  }

  .pw__group--nested {
    padding-block-start: 0.4rem;
    border-block-start: 0;
  }

  /* Floating the legend lays it out inside the fieldset rather than across its border. */
  .pw__group > legend {
    float: left;
    width: 100%;
    padding: 0;
  }

  .pw__segments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0.2rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
  }

  .pw__segment {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 2.5rem;
    padding-inline: 0.25rem;
    border-radius: calc(var(--radius-sm) - 0.15rem);
    font-weight: 500;
    font-size: var(--text-step--1);
    text-align: center;
    cursor: pointer;
  }

  .pw__segment input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .pw__segment:has(input:checked) {
    background: var(--accent-soft);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .pw__segment:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pw__range {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 3rem;
    align-items: center;
    gap: 0.9rem;
  }

  .pw__range input {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    accent-color: var(--accent);
  }

  .pw__output {
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    font: 600 var(--text-step--1) / 1.2 var(--mono);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .pw__checks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1rem;
  }

  .pw__check {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .pw__check input {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .pw__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .pw__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .pw__select,
  .pw__number {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-step--1);
  }

  .pw__number {
    width: 7rem;
    font-family: var(--mono);
  }

  .pw__range input:focus-visible,
  .pw__check input:focus-visible,
  .pw__select:focus-visible,
  .pw__number:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pw__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid var(--rule);
  }

  .pw__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .pw__status {
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
  }

  .pw__status[data-invalid] {
    background: var(--warning-soft);
  }

  .pw__meter {
    display: grid;
    gap: 0.6rem;
  }

  .pw__meter[hidden] {
    display: none;
  }

  .pw__bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--paper-sunken);
    box-shadow: inset 0 0 0 1px var(--rule);
    overflow: hidden;
  }

  .pw__bar span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--danger);
    transition: width var(--duration-base) var(--ease-out-expo);
  }

  .pw__meter[data-strength="fair"] .pw__bar span {
    background: var(--warning);
  }

  .pw__meter[data-strength="strong"] .pw__bar span,
  .pw__meter[data-strength="veryStrong"] .pw__bar span {
    background: var(--success);
  }

  .pw__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1rem;
  }

  .pw__stats div {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .pw__wide {
    grid-column: 1 / -1;
  }

  .pw__stats dt {
    color: var(--ink-faint);
    font: 500 var(--text-step--2) / 1.2 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pw__stats dd {
    font-weight: 500;
    font-size: var(--text-step--1);
  }

  .pw__list {
    display: grid;
    gap: 0.5rem;
  }

  .pw__list :global(li) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .pw__list :global(code) {
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    font: 500 var(--text-step--1) / 1.5 var(--mono);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  @media (forced-colors: active) {
    .pw__segment:has(input:checked) {
      outline: 2px solid Highlight;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw__bar span {
      transition: none;
    }
  }

  @media (width < 56rem) {
    .pw {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 30rem) {
    .pw__checks,
    .pw__fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
