---
import PageHero from "../../components/sections/PageHero.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { formatInteger, maxBase, minBase, widths } from "../../lib/base-tool";
import { toolPageProps } from "../../lib/tool-catalogue";

const t = useTranslations(localeOf(Astro));
const start = 51_966n;
const customBase = 36;
const bases = [
  { base: 2, id: "base-binary", label: t("tools.base.binary"), mode: "numeric" },
  { base: 8, id: "base-octal", label: t("tools.base.octal"), mode: "numeric" },
  { base: 10, id: "base-decimal", label: t("tools.base.decimal"), mode: "text" },
  { base: 16, id: "base-hex", label: t("tools.base.hex"), mode: "text" },
] as const;
---

<Base {...toolPageProps("base", t)}>
  <PageHero label={t("nav.tools")} title={t("tools.base.title")} lede={t("tools.base.summary")} />
  <div
    class="container-page base"
    data-base-tool
    data-invalid-number={t("tools.base.invalid")}
    data-invalid-base={t("tools.base.invalidBase")}
    data-status-text={t("tools.base.status")}
    data-too-wide={t("tools.base.tooWide")}
    data-signed-word={t("tools.base.signedWord")}
    data-unsigned-word={t("tools.base.unsignedWord")}
    data-bit-label={t("tools.base.bit")}
    data-byte-label={t("tools.base.byte")}
    data-no-fit={t("tools.base.noFit")}
    data-no-bytes={t("tools.base.noBytes")}
  >
    <div class="base__input card">
      <fieldset class="base__fields">
        <legend class="label">{t("tools.base.values")}</legend>
        <p id="base-hint" class="base__hint">
          {t("tools.base.hint")}
        </p>
        {bases.map(({ base, id, label, mode }) => (
          <div class="base__field">
            <label class="base__label" for={id}>
              <span>{label}</span>{" "}
              <span class="base__radix">{t("tools.base.baseN").replace("{base}", String(base))}</span>
            </label>
            <input
              id={id}
              type="text"
              class="base__value"
              value={formatInteger(start, base)}
              inputmode={mode}
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-describedby={`base-hint ${id}-error`}
              data-value={String(base)}
            />
            <p id={`${id}-error`} class="base__error" data-error hidden></p>
          </div>
        ))}
        <div class="base__field base__field--custom">
          <div class="base__radix-field">
            <label class="base__label" for="base-radix">
              {t("tools.base.custom")}
            </label>
            <input
              id="base-radix"
              type="number"
              class="base__value base__value--radix"
              min={minBase}
              max={maxBase}
              step="1"
              value={customBase}
              aria-describedby="base-radix-error"
              data-radix
            />
          </div>
          <div class="base__custom-value">
            <label class="base__label" for="base-custom">
              {t("tools.base.customValue")}
            </label>
            <input
              id="base-custom"
              type="text"
              class="base__value"
              value={formatInteger(start, customBase)}
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-describedby="base-hint base-custom-error"
              data-value="custom"
            />
          </div>
          <p id="base-radix-error" class="base__error" data-radix-error hidden></p>
          <p id="base-custom-error" class="base__error" data-error hidden></p>
        </div>
      </fieldset>
      <p class="base__status" role="status" data-status></p>
    </div>

    <div class="base__result card">
      <section class="base__section" aria-labelledby="base-bits">
        <h2 id="base-bits" class="label">
          {t("tools.base.bits")}
        </h2>
        <fieldset class="base__options">
          <legend class="base__label">{t("tools.base.width")}</legend>
          <div class="base__segments">
            {widths.map((bits) => (
              <label class="base__segment">
                <input type="radio" name="base-width" value={bits} checked={bits === 16} data-width />
                <span>{t("tools.base.widthBits").replace("{bits}", String(bits))}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="base__check">
          <input type="checkbox" aria-describedby="base-signed-hint" data-signed />
          <span>{t("tools.base.signed")}</span>
        </label>
        <p id="base-signed-hint" class="base__hint">
          {t("tools.base.signedHint")}
        </p>
        <p class="base__hint">{t("tools.base.gridHint")}</p>
        <div class="base__grid" data-grid></div>
        <p class="base__note" data-grid-note hidden></p>
      </section>

      <section class="base__section" aria-labelledby="base-order">
        <h2 id="base-order" class="label">
          {t("tools.base.byteOrder")}
        </h2>
        <dl class="base__order">
          <div>
            <dt>{t("tools.base.bigEndian")}</dt>
            <dd>
              <code data-big></code>
            </dd>
          </div>
          <div>
            <dt>{t("tools.base.littleEndian")}</dt>
            <dd>
              <code data-little></code>
            </dd>
          </div>
        </dl>
      </section>

      <div class="base__section">
        <h2 id="base-twos" class="label">
          {t("tools.base.twos")}
        </h2>
        <section class="base__table" aria-labelledby="base-twos" data-scroll>
          <table>
            <thead>
              <tr>
                <th scope="col">{t("tools.base.width")}</th>
                <th scope="col">{t("tools.base.hex")}</th>
                <th scope="col">{t("tools.base.asSigned")}</th>
                <th scope="col">{t("tools.base.asUnsigned")}</th>
              </tr>
            </thead>
            <tbody>
              {widths.map((bits) => (
                <tr data-row={bits}>
                  <th scope="row">{t("tools.base.widthBits").replace("{bits}", String(bits))}</th>
                  <td>
                    <code data-hex></code>
                  </td>
                  <td data-signed-value></td>
                  <td data-unsigned-value></td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import { initBase } from "../../scripts/tool-base";

  initBase();
</script>

<style>
  .base {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
    padding-block-end: var(--spacing-section);
  }

  .base > .card {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .base__fields,
  .base__options {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Floating the legend lays it out inside the fieldset rather than across its border. */
  .base__fields > legend,
  .base__options > legend {
    float: left;
    width: 100%;
    padding: 0;
  }

  .base__options {
    gap: 0.4rem;
  }

  .base__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .base__field--custom {
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.4rem 0.75rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--rule);
  }

  .base__field--custom .base__error {
    grid-column: 1 / -1;
  }

  .base__radix-field,
  .base__custom-value {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .base__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-weight: 500;
    font-size: var(--text-step--1);
  }

  .base__radix {
    color: var(--ink-faint);
    font: 500 var(--text-step--2) / 1 var(--mono);
  }

  .base__value {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: 500 var(--text-step-0) / 1.4 var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .base__value[aria-invalid="true"] {
    border-color: var(--warning);
  }

  .base__value:focus-visible,
  .base__check input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .base__hint {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .base__error,
  .base__note {
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--warning-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
  }

  .base__error[hidden],
  .base__note[hidden] {
    display: none;
  }

  .base__status {
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--ink);
    font-size: var(--text-step--1);
    overflow-wrap: anywhere;
  }

  .base__section {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .base__section + .base__section {
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
  }

  .base__segments {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0.2rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
  }

  .base__segment {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 2.25rem;
    padding-inline: 0.25rem;
    border-radius: calc(var(--radius-sm) - 0.15rem);
    font-weight: 500;
    font-size: var(--text-step--1);
    text-align: center;
    cursor: pointer;
  }

  .base__segment input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .base__segment:has(input:checked) {
    background: var(--accent-soft);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .base__segment:has(input:disabled) {
    color: var(--ink-faint);
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .base__segment:has(input:disabled) input {
    cursor: not-allowed;
  }

  .base__segment:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .base__check {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-size: var(--text-step--1);
    cursor: pointer;
  }

  .base__check input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .base__check + .base__hint {
    margin-block-start: -0.9rem;
  }

  .base__grid {
    display: grid;
    gap: 0.5rem;
  }

  .base__grid :global(.base__byte) {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .base__grid :global(.base__byte legend) {
    float: left;
    padding: 0;
    color: var(--ink-faint);
    font: 500 var(--text-step--2) / 1 var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .base__grid :global(.base__bits) {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.25rem;
  }

  /* A gap between the two nibbles of each byte makes long patterns easier to read. */
  .base__grid :global(.base__bit:nth-child(5)) {
    margin-inline-start: 0.35rem;
  }

  .base__grid :global(.base__bit) {
    display: grid;
    place-items: center;
    min-width: 0;
    height: 2.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.35rem;
    background: var(--paper-sunken);
    color: var(--ink-muted);
    font: 600 var(--text-step--1) / 1 var(--mono);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .base__grid :global(.base__bit[aria-pressed="true"]) {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .base__grid :global(.base__bit:hover) {
    border-color: var(--ink-faint);
  }

  .base__grid :global(.base__bit:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .base__order {
    display: grid;
    gap: 0.5rem;
  }

  .base__order div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
  }

  .base__order dt {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .base__order code,
  .base__table code {
    font: 500 var(--text-step--1) / 1.5 var(--mono);
    overflow-wrap: anywhere;
  }

  .base__table {
    overflow-x: auto;
    border-radius: var(--radius-sm);
  }

  .base__table:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .base__table table {
    width: 100%;
    min-width: 30rem;
    border-collapse: collapse;
    font-size: var(--text-step--1);
    font-variant-numeric: tabular-nums;
  }

  .base__table thead th {
    padding-block: 0 0.5rem;
    color: var(--ink-muted);
    font-weight: 500;
    font-size: var(--text-step--2);
    text-align: start;
  }

  .base__table tbody th,
  .base__table td {
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-block-start: 1px solid var(--rule);
    text-align: start;
    vertical-align: top;
  }

  .base__table tbody th {
    font-weight: 500;
    white-space: nowrap;
  }

  .base__table td {
    font-family: var(--mono);
    white-space: nowrap;
  }

  .base__table tr[data-invalid] td,
  .base__table tr[data-invalid] th {
    color: var(--ink-muted);
  }

  @media (forced-colors: active) {
    .base__segment:has(input:checked),
    .base__grid :global(.base__bit[aria-pressed="true"]) {
      outline: 2px solid Highlight;
    }
  }

  @media (width < 56rem) {
    .base {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 30rem) {
    .base__grid :global(.base__byte) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .base__order div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>
