---
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { getArticles, getTags } from "../../lib/articles";

const t = useTranslations(localeOf(Astro));
const tags = getTags(await getArticles());
---

<Base title={t("tags.title")}>
  <section class="container-page page">
    <h1 class="page-title">{t("tags.title")}</h1>
    <ul class="topics" role="list">
      {tags.map(({ tag, count }) => (
        <li>
          <a class="topic" href={`/tags/${tag}/`}>
            <span class="topic__name">{tag}</span>
            <span class="meta">{t("tags.count", { count })}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--spacing-section);
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    margin-block-start: 3rem;
    border-block-start: 2px solid var(--rule-strong);
    border-inline-start: 1px solid var(--rule-strong);
  }

  .topic {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.4rem 1.25rem 1.25rem;
    border-inline-end: 1px solid var(--rule-strong);
    border-block-end: 1px solid var(--rule-strong);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .topic:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .topic:hover .meta {
    color: inherit;
  }

  .topic__name {
    font-weight: 800;
    font-size: var(--text-step-2);
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
</style>
