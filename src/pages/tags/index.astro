---
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { getArticles, getTags } from "../../lib/articles";

const t = useTranslations(localeOf(Astro));
const tags = getTags(await getArticles());
---

<Base title={t("tags.title")}>
  <section class="container-page page">
    <h1 class="page-title">{t("tags.title")}</h1>
    <ul class="topics" role="list">
      {tags.map(({ tag, count }) => (
        <li>
          <a class="topic" href={`/tags/${tag}/`}>
            <span class="topic__name">{tag}</span>
            <span class="meta">{t("tags.count", { count })}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--spacing-section);
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    margin-block-start: 2.5rem;
  }

  .topic {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--paper-raised) 85%, transparent);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      translate var(--duration-base) var(--ease-out-expo);
  }

  .topic:hover {
    border-color: var(--rule-strong);
    translate: 0 -2px;
  }

  .topic:hover .topic__name {
    color: var(--accent);
  }

  .topic__name {
    font-weight: 600;
    font-size: var(--text-step-1);
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
</style>
