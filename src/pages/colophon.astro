---
import { getEntry } from "astro:content";

import MdxPage from "../components/sections/MdxPage.astro";
import { useTranslations } from "../i18n";
import { localeOf } from "../i18n/astro";

const t = useTranslations(localeOf(Astro));
const page = await getEntry("pages", "colophon");
if (!page) throw new Error("content/pages/colophon.mdx is missing");
---

<MdxPage page={page} label={t("nav.colophon")} />
