---
import { cv } from "../../content/data/cv";
import { profile } from "../../content/data/profile";
import CvRoles from "../components/sections/CvRoles.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeading from "../components/sections/SectionHeading.astro";
import { useTranslations } from "../i18n";
import { localeOf } from "../i18n/astro";
import Base from "../layouts/Base.astro";
import { publishableCv } from "../lib/cv";
import { filled } from "../lib/placeholders";
import { site } from "../site.config";

const t = useTranslations(localeOf(Astro));
const city = filled(profile.location.city);
const { summary, roles, skills, education } = publishableCv(cv);
const hasRoles = roles.length > 0;
const contact = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: site.url.replace("https://", ""), href: site.url },
  ...site.social.map((item) => ({ label: item.href.replace("https://", "").replace("www.", ""), href: item.href })),
];
---

<Base title={t("cv.title")} description={t("cv.description")} image="/og/cv.png">
  <PageHero label={t("nav.cv")} title={profile.name} lede={profile.headline}>
    <a href="/cv.pdf" class="button button--primary" download>
      {t("cv.download")} <span aria-hidden="true">↓</span>
    </a>
    <button type="button" class="button" data-print>
      {t("cv.print")}
    </button>
  </PageHero>

  <div class="container-page cv">
    <aside class="cv__aside">
      <p class="label">{city ? `${city}, ${profile.location.country}` : profile.location.country}</p>
      <ul class="cv__contact" role="list">
        {contact.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </aside>
    <div class="cv__main">
      {summary && <p class="cv__summary">{summary}</p>}

      {hasRoles && (
        <section aria-labelledby="experience-title" class="cv__section">
          <SectionHeading id="experience-title" title={t("cv.experience")} />
          <CvRoles detailed />
        </section>
      )}

      <section aria-labelledby="skills-title" class="cv__section">
        <SectionHeading id="skills-title" title={t("cv.skills")} />
        <dl class="cv__skills">
          {skills.map((group) => (
            <div class="cv__skill">
              <dt class="label">{group.group}</dt>
              <dd>
                <ul class="cv__tags" role="list">
                  {group.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      {education.length > 0 && (
        <section aria-labelledby="education-title" class="cv__section">
          <SectionHeading id="education-title" title={t("cv.education")} />
          <ul class="cv__education" role="list">
            {education.map((item) => (
              <li class="cv__school">
                <span class="cv__years">{item.years}</span>
                <span>
                  <strong>{item.qualification}</strong>, {item.institution}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
      <p class="cv__online label">
        {t("cv.online")}: {site.url.replace("https://", "")}/cv/
      </p>
    </div>
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll("[data-print]")) {
    button.addEventListener("click", () => window.print());
  }
</script>

<style>
  .cv {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2.5rem;
    padding-block: 2rem var(--spacing-section);
    border-block-start: 1px solid var(--rule);
  }

  .cv__aside {
    position: sticky;
    top: 6rem;
    align-self: start;
    display: grid;
    gap: 1rem;
  }

  .cv__contact {
    display: grid;
    gap: 0.35rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .cv__contact a {
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
  }

  .cv__summary {
    max-width: 44ch;
    font-weight: 500;
    font-size: var(--text-step-2);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .cv__section {
    margin-block-start: var(--spacing-section);
  }

  .cv__section :global(.section-title) {
    font-size: var(--text-step-3);
  }

  .cv__skills {
    border-block-end: 1px solid var(--rule-strong);
  }

  .cv__skill {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-start: 1px solid var(--rule-strong);
  }

  .cv__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cv__school {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid var(--rule-strong);
  }

  .cv__years {
    font: 500 var(--text-step--1) / 1.4 var(--mono);
  }

  .cv__online {
    display: none;
    margin-block-start: 2rem;
  }

  @media (width < 56rem) {
    .cv {
      grid-template-columns: 1fr;
    }

    .cv__aside {
      position: static;
    }

    .cv__skill,
    .cv__school {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.page-hero__actions),
    :global(.skip-link) {
      display: none !important;
    }

    :global(html) {
      font-size: 80%;
      background: white;
      color: black;
    }

    :global(.page-hero) {
      padding-block: 0 1rem;
    }

    .cv {
      grid-template-columns: 1fr 3fr;
      padding-block: 1rem 0;
    }

    .cv__section {
      margin-block-start: 2rem;
      break-inside: avoid-page;
    }

    .cv__online {
      display: block;
    }

    @page {
      margin: 14mm;
    }
  }
</style>
