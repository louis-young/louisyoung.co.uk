---
import { render } from "astro:content";

import Callout from "../../components/mdx/Callout.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { caseNumber, getWork, workPath, type CaseStudy } from "../../lib/work";

export const getStaticPaths = async () => {
  const work = await getWork();
  return work.map((study, index) => ({
    params: { slug: study.id },
    props: { study, index, next: work[(index + 1) % work.length], nextIndex: (index + 1) % work.length },
  }));
};

interface Props {
  study: CaseStudy;
  index: number;
  next: CaseStudy | undefined;
  nextIndex: number;
}

const { study, index, next, nextIndex } = Astro.props;
const { data } = study;
const { Content, headings } = await render(study);
const t = useTranslations(localeOf(Astro));
const facts = [
  { label: t("work.client"), value: data.client },
  { label: t("work.role"), value: data.role },
  { label: t("work.year"), value: data.year },
];
const sections = headings.filter((heading) => heading.depth === 2);
const hasNext = next !== undefined && next.id !== study.id;
---

<Base title={data.title} description={data.summary} image={`/og/work-${study.id}.png`} type="article">
  <article class="case" data-pagefind-body>
    <header class="container-page case__header">
      <p class="label case__crumbs reveal">
        <a href="/work/">{t("nav.work")}</a>
        <span aria-hidden="true">/</span>
        <span class="case__number">{caseNumber(index)}</span>
      </p>
      <h1 class="page-title case__title reveal" style="--reveal-index: 1">
        {data.title}
      </h1>
      <p class="page-lede case__summary reveal" style="--reveal-index: 2">
        {data.summary}
      </p>
      <dl class="case__facts card reveal" style="--reveal-index: 3">
        {facts.map((fact) => (
          <div class="case__fact">
            <dt class="label">{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
        <div class="case__fact case__fact--stack">
          <dt class="label">{t("work.stack")}</dt>
          <dd>
            <ul class="case__stack" role="list">
              {data.stack.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </header>

    {data.outcomes.length > 0 && (
      <section class="container-page outcomes" aria-label={t("work.outcomes")}>
        <ul class="outcomes__list" role="list">
          {data.outcomes.map((outcome, position) => (
            <li class="outcome card rise">
              <span class="outcome__index" aria-hidden="true">
                {String(position + 1).padStart(2, "0")}
              </span>
              <span class="outcome__value">{outcome.value}</span>
              <span class="outcome__label">{outcome.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="container-page case__layout">
      {sections.length > 1 && (
        <nav class="case__toc" aria-labelledby="case-contents-title">
          <h2 id="case-contents-title" class="label">
            {t("article.contents")}
          </h2>
          <ol class="case__toc-list" role="list">
            {sections.map((heading, position) => (
              <li>
                <a href={`#${heading.slug}`} class="case__toc-link">
                  <span class="case__toc-number" aria-hidden="true">
                    {String(position + 1).padStart(2, "0")}
                  </span>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="case__content">
        <div class="case__body prose">
          <Content components={{ Callout }} />
        </div>
        {data.links.length > 0 && (
          <ul class="case__links" role="list">
            {data.links.map((link) => (
              <li>
                <a href={link.href} class="button button--small">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </article>

  <nav class="container-page case__nav" aria-label={t("work.next")}>
    {hasNext && (
      <a href={workPath(next)} class="case__next card card--interactive">
        <span class="case__next-meta">
          <span class="label">{t("work.next")}</span>
          <span class="case__next-number" aria-hidden="true">
            {caseNumber(nextIndex)}
          </span>
        </span>
        <span class="case__next-title">{next.data.title}</span>
        <span class="case__next-summary">{next.data.summary}</span>
        <span class="case__next-arrow" aria-hidden="true">
          →
        </span>
      </a>
    )}
    <div class="case__nav-actions">
      <a href="/work/" class="button button--small">
        <span aria-hidden="true">←</span>
        {t("work.all")}
      </a>
      <a href="/hire/" class="button button--small button--signal">
        {t("work.cta")} <span aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</Base>

<style>
  .case__header {
    padding-block: clamp(3rem, 1.5rem + 5vw, 6rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .case__crumbs {
    display: flex;
    gap: 0.6rem;
    color: var(--ink-faint);
  }

  .case__crumbs a {
    color: var(--accent);
    text-decoration: none;
  }

  .case__crumbs a:hover {
    text-decoration: underline;
  }

  .case__title {
    margin-block-start: 1.25rem;
    max-width: 18ch;
    font-size: var(--text-display);
    line-height: 1;
  }

  .case__summary {
    margin-block-start: 1.5rem;
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 0.7fr)) minmax(0, 1.6fr);
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
  }

  .case__fact {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.25rem 1.5rem;
  }

  .case__fact + .case__fact {
    border-inline-start: 1px solid var(--rule);
  }

  .case__fact dd {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .case__stack .tag {
    color: var(--ink);
  }

  @media (width < 56rem) {
    .case__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .case__fact--stack {
      grid-column: 1 / -1;
      border-block-start: 1px solid var(--rule);
      border-inline-start: 0 !important;
    }
  }

  @media (width < 30rem) {
    .case__facts {
      grid-template-columns: 1fr;
    }

    .case__fact + .case__fact {
      border-inline-start: 0;
      border-block-start: 1px solid var(--rule);
    }
  }

  /* Outcomes: the headline numbers, big. */
  .outcomes__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }

  .outcome {
    display: grid;
    align-content: end;
    gap: 0.75rem;
    min-height: clamp(10rem, 8rem + 6vw, 14rem);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    overflow: hidden;
    background:
      radial-gradient(18rem 10rem at 0% 100%, color-mix(in oklch, var(--glow-1) 55%, transparent), transparent 70%),
      color-mix(in oklch, var(--paper-raised) 92%, transparent);
  }

  .outcome__index {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--ink-faint);
  }

  .outcome__value {
    color: var(--accent);
    font-weight: 600;
    font-size: clamp(2.75rem, 1.8rem + 3.6vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .outcome__label {
    font: 500 var(--text-step--1) / 1.35 var(--mono);
    color: var(--ink-muted);
  }

  /* Body: a sticky contents column beside the write-up. */
  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 42rem) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding-block-start: var(--spacing-section);
  }

  .case__toc {
    position: sticky;
    top: 6rem;
    align-self: start;
    display: grid;
    gap: 0.9rem;
  }

  .case__toc-list {
    display: grid;
    gap: 0.1rem;
    border-inline-start: 1px solid var(--rule);
  }

  .case__toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-inline-start: -1px;
    padding: 0.4rem 0.85rem;
    border-inline-start: 1px solid transparent;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .case__toc-link:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .case__toc-number {
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--ink-faint);
  }

  .case__toc {
    grid-column: 1;
    max-width: 14rem;
  }

  .case__content {
    grid-column: 2;
    min-width: 0;
  }

  .case__body :global(h2) {
    scroll-margin-top: 6rem;
  }

  .case__body > :global(:first-child) {
    margin-block-start: 0;
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 2rem;
  }

  @media (width < 64rem) {
    .case__layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: 42rem;
      margin-inline: auto;
    }

    .case__content {
      grid-column: auto;
    }

    .case__toc {
      grid-column: auto;
      max-width: none;
      position: static;
      padding-block-end: 1.5rem;
      border-block-end: 1px solid var(--rule);
    }

    .case__toc-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      border: 0;
    }

    .case__toc-link {
      margin: 0;
      padding: 0.35rem 0.75rem;
      border: 1px solid var(--rule);
      border-radius: 999px;
      background: var(--paper-sunken);
    }
  }

  /* Next: one big card for the following case study. */
  .case__nav {
    display: grid;
    gap: 1.5rem;
    margin-block-start: var(--spacing-section);
    padding-block: 2rem var(--spacing-section);
    border-block-start: 1px solid var(--rule);
  }

  .case__next {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    padding-inline-end: clamp(4.5rem, 3rem + 4vw, 7rem);
    overflow: hidden;
    text-decoration: none;
    background:
      radial-gradient(32rem 16rem at 100% 100%, color-mix(in oklch, var(--glow-2) 55%, transparent), transparent 70%),
      color-mix(in oklch, var(--paper-raised) 92%, transparent);
  }

  .case__next-meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .case__next-meta .label {
    color: var(--accent);
  }

  .case__next-number {
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--ink-faint);
  }

  .case__next-title {
    font-weight: 600;
    font-size: var(--text-step-4);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .case__next-summary {
    max-width: 56ch;
    color: var(--ink-muted);
  }

  .case__next-arrow {
    position: absolute;
    right: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    bottom: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: var(--paper-raised);
    font-size: 1.2rem;
    transition:
      translate var(--duration-base) var(--ease-out-expo),
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .case__next:hover .case__next-arrow {
    translate: 4px 0;
    background: var(--ink);
    color: var(--paper);
  }

  .case__next:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .case__nav-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
