---
import { profile } from "../../../content/data/profile";
import PageHero from "../../components/sections/PageHero.astro";
import Repositories from "../../components/sections/Repositories.astro";
import SectionHeading from "../../components/sections/SectionHeading.astro";
import WorkTable from "../../components/sections/WorkTable.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { getRepositories } from "../../lib/github";
import { getWork } from "../../lib/work";

const t = useTranslations(localeOf(Astro));
const work = await getWork();
const repositories = await getRepositories(profile.github);
---

<Base title={t("work.title")} description={t("work.description")} image="/og/work.png">
  <PageHero label={`01 — ${t("nav.work")}`} title={t("home.selectedWork")} lede={t("work.intro")} />
  <section class="container-page section" aria-label={t("home.selectedWork")}>
    <WorkTable work={work} headingLevel="h2" />
  </section>
  {repositories.length > 0 && (
    <section class="container-page section" aria-labelledby="oss-title">
      <SectionHeading
        id="oss-title"
        title={t("oss.title")}
        link={{ href: `https://github.com/${profile.github}`, label: t("oss.all") }}
      />
      <p class="oss-intro">{t("oss.intro")}</p>
      <Repositories repositories={repositories} />
    </section>
  )}
  <section class="container-page cta" aria-label={t("work.cta")}>
    <p class="cta__text">{t("work.cta")}</p>
    <a href="/hire/" class="button button--signal">
      {t("home.hireTitle")} →
    </a>
  </section>
</Base>

<style>
  .section {
    padding-block-end: var(--spacing-section);
  }

  .oss-intro {
    margin-block: -1rem 1.5rem;
    color: var(--ink-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2.5rem var(--spacing-section);
    border-block-start: 2px solid var(--rule-strong);
  }

  .cta__text {
    font-weight: 800;
    font-size: var(--text-step-3);
    line-height: 1;
    letter-spacing: -0.04em;
  }
</style>
