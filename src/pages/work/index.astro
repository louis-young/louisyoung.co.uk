---
import { profile } from "../../../content/data/profile";
import PageHero from "../../components/sections/PageHero.astro";
import Repositories from "../../components/sections/Repositories.astro";
import SectionHeading from "../../components/sections/SectionHeading.astro";
import WorkTable from "../../components/sections/WorkTable.astro";
import { useTranslations } from "../../i18n";
import { localeOf } from "../../i18n/astro";
import Base from "../../layouts/Base.astro";
import { getRepositories } from "../../lib/github";
import { getWork } from "../../lib/work";

const t = useTranslations(localeOf(Astro));
const work = await getWork();
const repositories = await getRepositories(profile.github);
---

<Base title={t("work.title")} description={t("work.description")} image="/og/work.png">
  <PageHero label={t("nav.work")} title={t("home.selectedWork")} lede={t("work.intro")} />
  <section class="container-page section" aria-label={t("home.selectedWork")}>
    {work.length > 0 ? (
      <WorkTable work={work} headingLevel="h2" />
    ) : (
      <div class="card empty">
        <p class="empty__text">{t("work.empty")}</p>
        <a href="/writing/" class="button button--small">
          {t("home.allWriting")} <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </section>
  {repositories.length > 0 && (
    <section class="container-page section" aria-labelledby="oss-title">
      <SectionHeading
        id="oss-title"
        title={t("oss.title")}
        link={{ href: `https://github.com/${profile.github}`, label: t("oss.all") }}
      />
      <p class="oss-intro">{t("oss.intro")}</p>
      <Repositories repositories={repositories} />
    </section>
  )}
</Base>

<style>
  .section {
    padding-block-end: var(--spacing-section);
  }

  .oss-intro {
    margin-block: -1rem 1.5rem;
    color: var(--ink-muted);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .empty__text {
    max-width: 52ch;
    color: var(--ink-muted);
  }
</style>
