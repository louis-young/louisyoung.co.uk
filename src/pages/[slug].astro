---
import { Picture } from "astro:assets";
import { render } from "astro:content";

import ArticleMeta from "../components/ArticleMeta.astro";
import ArticleRow from "../components/ArticleRow.astro";
import CopyLink from "../components/CopyLink.astro";
import Icon from "../components/Icon.astro";
import Callout from "../components/mdx/Callout.astro";
import Demo from "../components/mdx/Demo.astro";
import Sandbox from "../components/mdx/Sandbox.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Toc from "../components/Toc.astro";
import { useTranslations } from "../i18n";
import { localeOf } from "../i18n/astro";
import Base from "../layouts/Base.astro";
import { articlePath, getAdjacent, getArticles, getRelated, type Article } from "../lib/articles";
import { estimateReadingTime } from "../lib/reading-time";
import { absoluteUrl, articleSchema } from "../lib/seo";
import { buildToc } from "../lib/toc";
import { site } from "../site.config";

export const getStaticPaths = async () => {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, articles } }));
};

interface Props {
  article: Article;
  articles: Article[];
}

const { article, articles } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const t = useTranslations(localeOf(Astro));

const minutes = estimateReadingTime(article.body ?? "");
const toc = buildToc(headings);
const { previous, next } = getAdjacent(articles, article.id);
const related = getRelated(articles, article, 2);
const ogImage = `/og/${article.id}.png`;
const editUrl = `${site.repository}/edit/${site.defaultBranch}/content/articles/${article.id}/index.mdx`;
---

<Base
  title={data.title}
  description={data.description}
  image={ogImage}
  type="article"
  published={data.date}
  updated={data.updated}
  schema={articleSchema({
    title: data.title,
    description: data.description,
    url: absoluteUrl(articlePath(article)),
    image: absoluteUrl(ogImage),
    published: data.date,
    updated: data.updated,
    tags: data.tags,
  })}
>
  <ReadingProgress />
  <article class="article" data-pagefind-body>
    <header class="article__header container-page">
      <div class="article__aside" data-pagefind-ignore>
        <p class="label article__section">
          <a href="/writing/">02 — {t("nav.writing")}</a>
        </p>
        <ArticleMeta date={data.date} updated={data.updated} minutes={minutes} class="article__meta" />
        <ul class="article__tags" role="list" aria-label={t("article.tags")}>
          {data.tags.map((tag) => (
            <li>
              <a class="tag" href={`/tags/${tag}/`} data-pagefind-filter="tag">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="article__intro">
        <h1 class="article__title" style={`view-transition-name: title-${article.id}`}>
          {data.title}
        </h1>
        <p class="article__lede">{data.description}</p>
      </div>
    </header>

    <figure class="article__cover container-page" data-pagefind-ignore>
      <div class="article__cover-frame">
        <Picture
          src={data.cover.src}
          alt={data.cover.alt}
          formats={["avif", "webp"]}
          widths={[640, 960, 1280]}
          sizes="(min-width: 74rem) 74rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="article__cover-image"
          style={`view-transition-name: cover-${article.id}`}
        />
      </div>
    </figure>

    <div class="article__layout">
      <div class="article__toc" data-pagefind-ignore>
        <Toc items={toc} />
      </div>
      <div class="article__body prose" data-code-label={t("article.codeLabel")}>
        <Content components={{ Callout, Demo, Sandbox }} />
      </div>
    </div>

    <footer class="article__footer container-text" data-pagefind-ignore>
      <div class="article__actions">
        <CopyLink />
        <a class="button" href={editUrl} rel="noopener noreferrer">
          <Icon name="edit" size={16} />
          {t("article.editOnGitHub")}
        </a>
        <a class="button" href="#main">
          <Icon name="arrow-up" size={16} />
          {t("article.backToTop")}
        </a>
      </div>

      {(previous || next) && (
        <nav class="pager" aria-label={`${t("article.previous")} / ${t("article.next")}`}>
          {previous ? (
            <a class="pager__link" href={articlePath(previous)} rel="prev">
              <span class="eyebrow">
                <Icon name="arrow-left" size={14} /> {t("article.previous")}
              </span>
              <span class="pager__title">{previous.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="pager__link pager__link--next" href={articlePath(next)} rel="next">
              <span class="eyebrow">
                {t("article.next")} <Icon name="arrow-right" size={14} />
              </span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>

  {related.length > 0 && (
    <aside class="container-page related" aria-labelledby="related-title" data-pagefind-ignore>
      <h2 id="related-title" class="section-title related__title">
        {t("article.related")}
      </h2>
      {related.map((item) => (
        <ArticleRow article={item} />
      ))}
    </aside>
  )}
</Base>

<script>
  /**
   * Expressive Code turns overflowing code blocks into focusable `role="region"` elements so
   * keyboard users can scroll them. Regions need distinct names, so number each one.
   */
  const body = document.querySelector<HTMLElement>("[data-code-label]");
  const template = body?.dataset["codeLabel"] ?? "";
  const blocks = [...document.querySelectorAll<HTMLPreElement>(".expressive-code pre")];
  const label = (pre: HTMLPreElement) => {
    if (pre.getAttribute("role") === "region") {
      pre.setAttribute("aria-label", template.replace("{index}", String(blocks.indexOf(pre) + 1)));
    } else pre.removeAttribute("aria-label");
  };
  const observer = new MutationObserver((records) => {
    for (const record of records) label(record.target as HTMLPreElement);
  });
  for (const pre of blocks) {
    label(pre);
    observer.observe(pre, { attributes: true, attributeFilter: ["role"] });
  }
</script>

<style>
  .article {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5.5rem) 0;
  }

  .article__header {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    padding-block-end: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .article__aside {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding-block-start: 0.6rem;
    border-block-start: 2px solid var(--rule-strong);
  }

  .article__section a {
    color: var(--ink);
    text-decoration: none;
  }

  .article__section a:hover {
    color: var(--signal-text);
  }

  .article__aside :global(.article__meta) {
    flex-direction: column;
    gap: 0.35rem;
  }

  .article__aside :global(.article__meta [aria-hidden="true"]) {
    display: none;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article__intro {
    grid-column: span 9;
  }

  .article__title {
    max-width: 18ch;
    font-weight: 800;
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 6.25rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .article__lede {
    margin-block-start: 1.5rem;
    max-width: 44ch;
    font-weight: 500;
    font-size: var(--text-step-1);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink-muted);
  }

  @media (width < 64rem) {
    .article__aside,
    .article__intro {
      grid-column: 1 / -1;
    }

    .article__aside {
      grid-row: 2;
      grid-template-columns: auto 1fr;
      align-items: center;
    }

    .article__aside :global(.article__meta) {
      flex-direction: row;
    }

    .article__aside :global(.article__meta [aria-hidden="true"]) {
      display: inline;
    }

    .article__section,
    .article__tags {
      grid-column: 1 / -1;
    }
  }

  .article__cover {
    margin-block: 0 clamp(2rem, 1.5rem + 3vw, 3.5rem);
  }

  /* Covers are set as a signal-orange duotone, so every article's photo belongs to the same system. */
  .article__cover-frame {
    border: 2px solid var(--rule-strong);
    background: var(--signal);
  }

  :global(.article__cover-image) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1) brightness(1.3);
    mix-blend-mode: multiply;
  }

  .article__layout {
    display: grid;
    grid-template-columns: minmax(var(--spacing-gutter), 1fr) min(42rem, 100% - 2 * var(--spacing-gutter)) minmax(
        var(--spacing-gutter),
        1fr
      );
  }

  .article__body {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .article__toc {
    grid-column: 2;
    grid-row: 1;
    display: none;
  }

  @media (width >= 80rem) {
    .article__toc {
      display: block;
      grid-column: 3;
      position: sticky;
      top: 6rem;
      align-self: start;
      max-height: calc(100dvh - 8rem);
      max-width: 17rem;
      margin-inline-start: 6rem;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (width < 80rem) {
    .article__toc {
      display: block;
      grid-row: 1;
      margin-block-end: 2.5rem;
      padding: 1.25rem 1.25rem 1rem;
      border: 2px solid var(--rule-strong);
    }

    .article__toc:empty {
      display: none;
    }

    .article__body {
      grid-row: 2;
    }
  }

  .article__footer {
    margin-block-start: var(--spacing-section);
    padding-block-start: 2rem;
    border-block-start: 2px solid var(--rule-strong);
  }

  .article__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-block-start: 2.5rem;
  }

  .pager__link {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.25rem;
    border: 2px solid var(--rule-strong);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .pager__link:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .pager__link:hover .eyebrow {
    color: inherit;
  }

  .pager__link .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pager__link--next {
    text-align: end;
    justify-items: end;
  }

  .pager__title {
    font-weight: 700;
    font-size: var(--text-step-1);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .related {
    padding-block: var(--spacing-section);
  }

  .related__title {
    padding-block-end: 1.5rem;
  }

  .related :global(.article-row:last-child) {
    border-block-end: 1px solid var(--rule-strong);
  }

  @media (width < 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
