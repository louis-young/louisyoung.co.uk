---
import { hire } from "../../content/data/hire";
import { profile } from "../../content/data/profile";
import Availability from "../components/sections/Availability.astro";
import EnquiryForm from "../components/sections/EnquiryForm.astro";
import Principles from "../components/sections/Principles.astro";
import SectionHeading from "../components/sections/SectionHeading.astro";
import Services from "../components/sections/Services.astro";
import { useTranslations } from "../i18n";
import { localeOf } from "../i18n/astro";
import Base from "../layouts/Base.astro";
import { bookingHref } from "../lib/hire";
import { filled, isPlaceholder } from "../lib/placeholders";

const t = useTranslations(localeOf(Astro));
const booking = bookingHref(profile.bookingUrl, profile.email, t("hire.bookingSubject"));
const testimonials = hire.testimonials.filter((item) => !isPlaceholder(`${item.quote} ${item.name} ${item.role}`));
const terms = hire.terms.filter((term) => !isPlaceholder(term.value));
const note = filled(profile.availability.note);
const step = (index: number) => String(index + 1).padStart(2, "0");
---

<Base title={t("hire.title")} description={t("hire.description")} image="/og/hire.png">
  <header class="container-page hero">
    <div class="hero__copy">
      <p class="label hero__label reveal">{t("nav.hire")}</p>
      <h1 class="page-title hero__title reveal" style="--reveal-index: 1">
        {t("hire.heading")}
      </h1>
      <p class="page-lede hero__lede reveal" style="--reveal-index: 2">
        {profile.intro}
      </p>
      <div class="hero__chip reveal" style="--reveal-index: 3">
        <Availability />
      </div>
      <div class="hero__actions reveal" style="--reveal-index: 4">
        <a href={booking} class="button button--signal" id="book">
          {t("hire.book")}
        </a>
        <a href="#enquiry-title" class="button">
          {t("hire.enquire")} <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <aside class="glance card reveal" style="--reveal-index: 3" aria-labelledby="glance-title">
      <div class="glance__head">
        <h2 id="glance-title" class="label">
          {t("hire.glance")}
        </h2>
        {note && <p class="glance__note">{note}</p>}
      </div>
      <ul class="glance__services" role="list">
        {hire.services.map((service) => (
          <li>
            <a href={`#service-${service.id}`} class="glance__service">
              <span>{service.name}</span>
              <span class="glance__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
      {terms.length > 0 && (
        <dl class="glance__terms">
          {terms.map((term) => (
            <div class="glance__term">
              <dt class="label">{term.label}</dt>
              <dd>{term.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </aside>
  </header>

  <section class="container-page section" aria-labelledby="services-title">
    <SectionHeading id="services-title" number={step(0)} title={t("hire.services")} />
    <p class="section__intro">{t("hire.servicesIntro")}</p>
    <Services detailed />
  </section>

  <section class="container-page section" aria-labelledby="process-title">
    <SectionHeading id="process-title" number={step(1)} title={t("hire.process")} />
    <p class="section__intro">{t("hire.processIntro")}</p>
    <ol class="timeline" role="list" style={`--steps: ${hire.process.length}`}>
      {hire.process.map((item, index) => (
        <li class="timeline__step">
          <span class="timeline__node" aria-hidden="true">
            {step(index)}
          </span>
          <h3 class="timeline__title">{item.title}</h3>
          <p class="timeline__body">{item.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-page section" aria-labelledby="why-title">
    <SectionHeading id="why-title" number={step(2)} title={t("hire.why")} />
    <p class="section__intro">{t("hire.whyIntro")}</p>
    <Principles />
  </section>

  {testimonials.length > 0 && (
    <section class="container-page section" aria-labelledby="testimonials-title">
      <SectionHeading id="testimonials-title" title={t("hire.testimonials")} />
      <ul class="quotes" role="list">
        {testimonials.map((item) => (
          <li class="quote card">
            <figure>
              <blockquote class="quote__text">
                <p>{item.quote}</p>
              </blockquote>
              <figcaption class="quote__by">
                <span class="quote__name">{item.name}</span>
                <span class="label">{item.role}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container-page section split" aria-labelledby="faq-title">
    <div class="split__aside">
      <SectionHeading id="faq-title" number={step(3)} title={t("hire.faq")} />
      <p class="split__intro">{t("hire.faqIntro")}</p>
      <a href={`mailto:${profile.email}`} class="link">
        {profile.email}
      </a>
    </div>
    <div class="faq card">
      {hire.faq.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-page section" aria-labelledby="enquiry-title">
    <div class="enquiry card">
      <div class="enquiry__aside">
        <SectionHeading id="enquiry-title" number={step(4)} title={t("hire.enquiry")} />
        <p class="enquiry__intro">{t("hire.enquiryIntro")}</p>
        <p class="label enquiry__next-title">{t("hire.next")}</p>
        <ol class="enquiry__next" role="list">
          {hire.process.map((item, index) => (
            <li>
              <span class="enquiry__next-number" aria-hidden="true">
                {index + 1}
              </span>
              {item.title}
            </li>
          ))}
        </ol>
      </div>
      <EnquiryForm />
    </div>
  </section>
</Base>

<style>
  /* Hero: the pitch and both calls to action on the left, the short version on the right. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: end;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) clamp(2.5rem, 1rem + 4vw, 4.5rem);
  }

  .hero__label {
    margin-block-end: 1rem;
    color: var(--accent);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1;
  }

  .hero__lede {
    margin-block-start: 1.5rem;
  }

  .hero__chip {
    margin-block-start: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 1rem;
  }

  .glance {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .glance__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .glance__note {
    font: 500 var(--text-step--2) / 1.3 var(--mono);
    color: var(--ink-muted);
  }

  .glance__services {
    display: grid;
    gap: 0.4rem;
  }

  .glance__service {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--paper-sunken);
    font-weight: 550;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .glance__service:hover {
    border-color: color-mix(in oklch, var(--accent) 50%, var(--rule));
  }

  .glance__arrow {
    color: var(--ink-faint);
    transition:
      translate var(--duration-base) var(--ease-out-expo),
      color var(--duration-fast) ease;
  }

  .glance__service:hover .glance__arrow {
    translate: 3px 0;
    color: var(--accent);
  }

  .glance__terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
  }

  .glance__term {
    display: grid;
    gap: 0.3rem;
  }

  .glance__term dd {
    font-size: var(--text-step--1);
    font-weight: 500;
  }

  @media (width < 56rem) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .section {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .section:last-child {
    padding-block-end: var(--spacing-section);
  }

  .section__intro {
    max-width: 56ch;
    margin-block: calc(-1 * clamp(0.75rem, 0.5rem + 1vw, 1.25rem)) clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    color: var(--ink-muted);
  }

  /* How it works: numbered nodes joined by a line, across on wide screens and down on narrow ones. */
  .timeline {
    --node: 2.75rem;
    --gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);

    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: var(--gap);
  }

  .timeline__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-block-start: calc(var(--node) + 1.25rem);
  }

  .timeline__step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: calc(var(--node) / 2);
    left: calc(var(--node) + 0.5rem);
    right: calc(-1 * var(--gap) + 0.5rem);
    height: 1px;
    background: linear-gradient(90deg, color-mix(in oklch, var(--accent) 70%, transparent), var(--rule-strong));
    transform-origin: left;
  }

  .timeline__node {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 1px solid color-mix(in oklch, var(--accent) 45%, var(--rule));
    border-radius: 50%;
    background: var(--paper-raised);
    box-shadow:
      0 0 0 6px var(--paper),
      0 10px 24px -10px var(--glow-1);
    font: 600 var(--text-step--1) / 1 var(--mono);
    color: var(--accent);
  }

  .timeline__title {
    font-weight: 600;
    font-size: var(--text-step-1);
    letter-spacing: -0.02em;
  }

  .timeline__body {
    max-width: 34ch;
    font-size: var(--text-step--1);
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .timeline__step::before {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 40%;
      }
    }
  }

  @keyframes draw {
    from {
      scale: 0 1;
    }
  }

  @media (width < 48rem) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .timeline__step {
      padding-block: 0.4rem 2rem;
      padding-inline-start: calc(var(--node) + 1.25rem);
    }

    .timeline__step:not(:last-child)::before {
      top: calc(var(--node) + 0.5rem);
      bottom: 0.5rem;
      left: calc(var(--node) / 2);
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, color-mix(in oklch, var(--accent) 70%, transparent), var(--rule-strong));
      transform-origin: top;
    }

    @keyframes draw {
      from {
        scale: 1 0;
      }
    }
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .quote figure {
    display: grid;
    gap: 1.25rem;
    height: 100%;
    padding: 1.75rem;
  }

  .quote__text {
    font-size: var(--text-step-1);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .quote__text p::before {
    content: "“";
  }

  .quote__text p::after {
    content: "”";
  }

  .quote__by {
    display: grid;
    gap: 0.25rem;
    align-self: end;
  }

  .quote__name {
    font-weight: 600;
  }

  /* Questions: a short intro beside the accordion. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .split__intro {
    max-width: 36ch;
    margin-block: -0.5rem 1rem;
    color: var(--ink-muted);
  }

  @media (width < 56rem) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .faq {
    display: grid;
    padding-inline: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .faq__item + .faq__item {
    border-block-start: 1px solid var(--rule);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.15rem;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-fast) ease;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--accent);
  }

  .faq__question:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* A plus drawn in CSS that turns into a minus. */
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--ink-muted);
    transition:
      rotate var(--duration-base) var(--ease-out-expo),
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.65rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate var(--duration-base) var(--ease-out-expo);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon {
    border-color: color-mix(in oklch, var(--accent) 50%, transparent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  .faq__answer {
    max-width: 60ch;
    padding-block-end: 1.25rem;
    color: var(--ink-muted);
  }

  /* Smooth open and close where the browser can animate to `auto`; elsewhere it simply snaps. */
  @supports (interpolate-size: allow-keywords) and selector(::details-content) {
    .faq {
      interpolate-size: allow-keywords;
    }

    .faq__item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--duration-base) var(--ease-out-expo),
        content-visibility var(--duration-base) allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  /* Start a project: what happens next beside the form. */
  .enquiry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background:
      radial-gradient(30rem 18rem at 0% 0%, color-mix(in oklch, var(--glow-1) 45%, transparent), transparent 70%),
      color-mix(in oklch, var(--paper-raised) 92%, transparent);
  }

  .enquiry__intro {
    max-width: 36ch;
    margin-block-start: -0.5rem;
    color: var(--ink-muted);
  }

  .enquiry__next-title {
    margin-block: 2rem 0.9rem;
  }

  .enquiry__next {
    display: grid;
    gap: 0.65rem;
    font-size: var(--text-step--1);
    font-weight: 500;
  }

  .enquiry__next li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .enquiry__next-number {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--accent);
  }

  @media (width < 56rem) {
    .enquiry {
      grid-template-columns: 1fr;
    }
  }

  @media (forced-colors: active) {
    .timeline__node,
    .faq__icon,
    .glance__service {
      border: 1px solid CanvasText;
    }

    .timeline__step::before {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
