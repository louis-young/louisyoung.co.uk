---
import { hire } from "../../content/data/hire";
import { profile } from "../../content/data/profile";
import Availability from "../components/sections/Availability.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeading from "../components/sections/SectionHeading.astro";
import Services from "../components/sections/Services.astro";
import { useTranslations } from "../i18n";
import { localeOf } from "../i18n/astro";
import Base from "../layouts/Base.astro";
import { bookingHref } from "../lib/hire";
import { isPlaceholder } from "../lib/placeholders";

const t = useTranslations(localeOf(Astro));
const booking = bookingHref(profile.bookingUrl, profile.email, t("hire.bookingSubject"));
const testimonials = hire.testimonials.filter((item) => !isPlaceholder(`${item.quote} ${item.name} ${item.role}`));
const terms = hire.terms.filter((term) => !isPlaceholder(term.value));
const fields = {
  name: t("hire.field.name"),
  email: t("hire.field.email"),
  company: t("hire.field.company"),
  service: t("hire.field.service"),
  budget: t("hire.field.budget"),
  start: t("hire.field.start"),
  message: t("hire.field.message"),
};
---

<Base title={t("hire.title")} description={t("hire.description")} image="/og/hire.png">
  <PageHero label={t("nav.hire")} title={t("hire.heading")} lede={profile.intro}>
    <Availability />
    <a href={booking} class="button button--primary" id="book">
      {t("hire.book")}
    </a>
  </PageHero>

  <section class="container-page section" aria-labelledby="services-title">
    <SectionHeading id="services-title" title={t("hire.services")} />
    <Services detailed />
  </section>

  <section class="container-page section" aria-labelledby="process-title">
    <SectionHeading id="process-title" title={t("hire.process")} />
    <ol class="process" role="list">
      {hire.process.map((step, index) => (
        <li class="process__step card">
          <span class="process__number">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="process__title">{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  {testimonials.length > 0 && (
    <section class="container-page section" aria-labelledby="testimonials-title">
      <SectionHeading id="testimonials-title" title={t("hire.testimonials")} />
      <ul class="quotes" role="list">
        {testimonials.map((item) => (
          <li class="quote card">
            <figure>
              <blockquote class="quote__text">
                <p>{item.quote}</p>
              </blockquote>
              <figcaption class="quote__by">
                <span class="quote__name">{item.name}</span>
                <span class="label">{item.role}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container-page section split" aria-labelledby="terms-title">
    <div>
      <SectionHeading id="terms-title" title={t("hire.terms")} />
      <dl class="terms">
        {terms.map((term) => (
          <div class="terms__row">
            <dt class="label">{term.label}</dt>
            <dd>{term.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div>
      <SectionHeading id="faq-title" title={t("hire.faq")} />
      <div class="faq">
        {hire.faq.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">{item.question}</summary>
            <p class="faq__answer">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page section" aria-labelledby="enquiry-title">
    <SectionHeading id="enquiry-title" title={t("hire.enquiry")} />
    <div class="enquiry card">
      <p class="enquiry__intro">{t("hire.enquiryIntro")}</p>
      <form
        class="enquiry__form"
        action={`mailto:${profile.email}`}
        method="post"
        enctype="text/plain"
        data-enquiry
        data-to={profile.email}
        data-subject={t("hire.enquirySubject")}
        data-labels={JSON.stringify(fields)}
      >
        <label class="field">
          <span class="field__label">{fields.name}</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="field">
          <span class="field__label">{fields.email}</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label class="field">
          <span class="field__label">
            {fields.company} <span class="field__optional">{t("hire.field.optional")}</span>
          </span>
          <input type="text" name="company" autocomplete="organization" />
        </label>
        <label class="field">
          <span class="field__label">{fields.service}</span>
          <select name="service">
            {hire.services.map((service) => (
              <option>{service.name}</option>
            ))}
            <option>{t("hire.serviceOther")}</option>
          </select>
        </label>
        <label class="field">
          <span class="field__label">
            {fields.budget} <span class="field__optional">{t("hire.field.optional")}</span>
          </span>
          <input type="text" name="budget" />
        </label>
        <label class="field">
          <span class="field__label">
            {fields.start} <span class="field__optional">{t("hire.field.optional")}</span>
          </span>
          <input type="text" name="start" />
        </label>
        <label class="field field--wide">
          <span class="field__label">{fields.message}</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <div class="field--wide enquiry__actions">
          <button type="submit" class="button button--signal">
            {t("hire.send")} <span aria-hidden="true">→</span>
          </button>
          <a href={`mailto:${profile.email}`} class="link">
            {profile.email}
          </a>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { enquiryMailto, type Enquiry } from "../lib/hire";

  const form = document.querySelector<HTMLFormElement>("[data-enquiry]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as unknown as Enquiry;
    const labels = JSON.parse(form.dataset["labels"] ?? "{}") as Record<keyof Enquiry, string>;
    const href = enquiryMailto(form.dataset["to"] ?? "", data, labels, form.dataset["subject"] ?? "");
    // Kept on the form too, so the composed email can be inspected (and tested) without a mail client.
    form.dataset["mailto"] = href;
    window.location.href = href;
  });
</script>

<style>
  .section {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .section:last-child {
    padding-block-end: var(--spacing-section);
  }

  .process {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    counter-reset: step;
  }

  .process__step {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
  }

  .process__number {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-block-end: 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font: 500 var(--text-step--2) / 1 var(--mono);
    color: var(--accent);
  }

  .process__title {
    font-weight: 600;
    font-size: var(--text-step-0);
    letter-spacing: -0.01em;
  }

  .process__step p {
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .quote figure {
    display: grid;
    gap: 1.25rem;
    height: 100%;
    padding: 1.75rem;
  }

  .quote__text {
    font-size: var(--text-step-1);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .quote__text p::before {
    content: "“";
  }

  .quote__text p::after {
    content: "”";
  }

  .quote__by {
    display: grid;
    gap: 0.25rem;
    align-self: end;
  }

  .quote__name {
    font-weight: 600;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }

  @media (width < 56rem) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .terms {
    display: grid;
  }

  .terms__row {
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) 2fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-block-start: 1px solid var(--rule);
  }

  .terms__row dd {
    color: var(--ink);
  }

  .faq {
    display: grid;
  }

  .faq__item {
    border-block-start: 1px solid var(--rule);
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: "+";
    color: var(--ink-faint);
    font-family: var(--mono);
    transition: rotate var(--duration-base) var(--ease-out-expo);
  }

  .faq__item[open] .faq__question::after {
    rotate: 45deg;
  }

  .faq__answer {
    padding-block-end: 1.1rem;
    color: var(--ink-muted);
  }

  .enquiry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .enquiry__intro {
    max-width: 32ch;
    color: var(--ink-muted);
  }

  .enquiry__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field__label {
    font-size: var(--text-step--1);
    font-weight: 500;
  }

  .field__optional {
    margin-inline-start: 0.35rem;
    color: var(--ink-faint);
    font-weight: 400;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    color: var(--ink);
    font: inherit;
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .field textarea {
    resize: vertical;
  }

  .field :focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 30%, transparent);
  }

  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  @media (width < 56rem) {
    .enquiry,
    .enquiry__form {
      grid-template-columns: 1fr;
    }
  }
</style>
