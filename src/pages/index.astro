---
import { getEntry } from "astro:content";

import { cv } from "../../content/data/cv";
import { hire } from "../../content/data/hire";
import { profile } from "../../content/data/profile";
import ArticleRow from "../components/ArticleRow.astro";
import Availability from "../components/sections/Availability.astro";
import CvRoles from "../components/sections/CvRoles.astro";
import HeroEditor from "../components/sections/HeroEditor.astro";
import LatestFeed from "../components/sections/LatestFeed.astro";
import Principles from "../components/sections/Principles.astro";
import Repositories from "../components/sections/Repositories.astro";
import SectionHeading from "../components/sections/SectionHeading.astro";
import Toolbox from "../components/sections/Toolbox.astro";
import ToolsTeaser from "../components/sections/ToolsTeaser.astro";
import WorkTable from "../components/sections/WorkTable.astro";
import { formatDate, useTranslations } from "../i18n";
import { localeOf } from "../i18n/astro";
import Base from "../layouts/Base.astro";
import { getArticles, getTags } from "../lib/articles";
import { yearsOfExperience } from "../lib/cv";
import { getRepositories } from "../lib/github";
import { bookingHref } from "../lib/hire";
import { filled } from "../lib/placeholders";
import { websiteSchema } from "../lib/seo";
import { getSnippets } from "../lib/snippets";
import { tools } from "../lib/tool-catalogue";
import { getWork, isPagePublished } from "../lib/work";

const locale = localeOf(Astro);
const t = useTranslations(locale);
const work = await getWork();
const allArticles = await getArticles();
const articles = allArticles.slice(0, 6);
const snippets = await getSnippets();
const topics = getTags(allArticles);
const repositories = await getRepositories(profile.github);
const nowEntry = await getEntry("pages", "now");
const now = nowEntry && isPagePublished(nowEntry) ? nowEntry : undefined;
const hasRoles = cv.roles.some((role) => filled(role.company) && filled(role.role));
const stars = repositories.reduce((total, repository) => total + repository.stars, 0);
const years = yearsOfExperience(cv.roles, new Date());
/** Every number is counted at build time: content, the tool catalogue, the CV and GitHub. */
const counts = [
  { value: allArticles.length, label: t("home.statArticles", { count: allArticles.length }) },
  { value: tools.length, label: t("home.statTools", { count: tools.length }) },
  ...(snippets.length > 0
    ? [{ value: snippets.length, label: t("home.statSnippets", { count: snippets.length }) }]
    : []),
  // Years of experience once the CV has a real start date; until then, how long the writing goes back.
  ...(years !== undefined
    ? [{ value: years, label: t("home.statYears", { count: years }) }]
    : allArticles.length > 0
      ? [{ value: allArticles.at(-1)!.data.date.getFullYear(), label: t("home.statSince"), raw: true }]
      : []),
  ...(repositories.length > 0
    ? [
        { value: repositories.length, label: t("home.statRepos", { count: repositories.length }) },
        { value: stars, label: t("home.statStars", { count: stars }) },
      ]
    : []),
];
/** Small counts tick up from zero in CSS; years and thousands are shown as they are. */
const stats = counts.map((stat) => ({
  ...stat,
  text: "raw" in stat ? String(stat.value) : stat.value.toLocaleString(locale),
  count: !("raw" in stat) && stat.value < 1000,
}));
---

<Base schema={websiteSchema()}>
  <section class="hero container-page" aria-labelledby="hero-title">
    <div class="hero__copy">
      <div class="reveal">
        <Availability />
      </div>
      <h1 id="hero-title" class="display hero__title reveal" style="--reveal-index: 1">
        <span class="gradient-text">{profile.name}</span>
        <span class="hero__headline">{profile.headline}</span>
      </h1>
      <p class="hero__intro reveal" style="--reveal-index: 2">
        {profile.intro}
      </p>
      <div class="hero__actions reveal" style="--reveal-index: 3">
        <a href={`mailto:${profile.email}`} class="button button--signal">
          {t("hire.email")} <span aria-hidden="true">→</span>
        </a>
        <a href={bookingHref(profile.bookingUrl, profile.email, t("hire.bookingSubject"))} class="button">
          {t("hire.book")}
        </a>
      </div>
      <p class="label hero__note reveal" style="--reveal-index: 4">
        {profile.availability.note}
      </p>
    </div>
    <div class="hero__visual">
      <HeroEditor />
    </div>

    <dl class="stats card reveal" style="--reveal-index: 5">
      {stats.map((stat) => (
        <div class="stats__item">
          <dt class="stats__label">{stat.label}</dt>
          <dd class="stats__value">
            {stat.count ? (
              <>
                <span class="visually-hidden">{stat.text}</span>
                <span class="stats__count" aria-hidden="true" style={`--to: ${stat.value}`} />
              </>
            ) : (
              stat.text
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <LatestFeed />

  {work.length > 0 && (
    <section class="container-page section" aria-labelledby="work-title">
      <SectionHeading
        id="work-title"
        number={t("nav.work")}
        title={t("home.selectedWork")}
        link={{ href: "/work/", label: t("home.allWork") }}
      />
      <WorkTable work={work} />
    </section>
  )}

  <section class="container-page section bento" aria-label={t("home.overview")}>
    <article class="card bento__writing rise" aria-labelledby="writing-title">
      <SectionHeading
        id="writing-title"
        number={t("nav.writing")}
        title={t("home.recentWriting")}
        link={{ href: "/writing/", label: t("home.allWriting") }}
      />
      <p class="bento__lede">{t("home.writingIntro")}</p>
      <div class="bento__list">
        {articles.map((article) => (
          <ArticleRow article={article} compact />
        ))}
      </div>
      <nav class="bento__topics" aria-label={t("tags.title")}>
        <ul role="list">
          {topics.map(({ tag }) => (
            <li>
              <a class="tag" href={`/tags/${tag}/`}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </article>

    <article class="card bento__hire rise" aria-labelledby="hire-title">
      <div class="bento__glow" aria-hidden="true"></div>
      <p class="label bento__eyebrow">{t("nav.hire")}</p>
      <h2 id="hire-title" class="section-title">
        {t("home.hireTitle")}
      </h2>
      <ul class="bento__services" role="list">
        {hire.services.map((service) => (
          <li>
            <a href={`/hire/#service-${service.id}`} class="bento__service">
              <span>{service.name}</span>
              <span class="bento__service-summary">{service.summary}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/hire/" class="button button--primary button--small">
        {t("home.hireDetails")} <span aria-hidden="true">→</span>
      </a>
    </article>

    <article class="card bento__toolbox rise" aria-labelledby="toolbox-title">
      <p class="label bento__eyebrow">{t("cv.skills")}</p>
      <h2 id="toolbox-title" class="bento__title">
        {t("cv.toolbox")}
      </h2>
      <Toolbox />
    </article>

    {now && (
      <article class="card bento__now rise" aria-labelledby="now-title">
        <p class="label bento__eyebrow">{t("nav.now")}</p>
        <h2 id="now-title" class="bento__title">
          {now.data.summary}
        </h2>
        <p class="meta">
          {t("page.updated", { date: formatDate(now.data.updated, locale) })} ·{" "}
          <a href="/now/" class="link">
            {t("home.nowMore")}
          </a>
        </p>
      </article>
    )}
  </section>

  <ToolsTeaser />

  <section class="container-page section" aria-labelledby="principles-title">
    <SectionHeading id="principles-title" number={t("home.approach")} title={t("home.principles")} />
    <Principles />
  </section>

  {hasRoles && (
    <section class="container-page section" aria-labelledby="cv-title">
      <SectionHeading
        id="cv-title"
        number={t("nav.cv")}
        title={t("cv.experience")}
        link={{ href: "/cv/", label: t("cv.heading") }}
      />
      <CvRoles limit={3} />
    </section>
  )}

  {repositories.length > 0 && (
    <section class="container-page section" aria-labelledby="oss-title">
      <SectionHeading
        id="oss-title"
        number="GitHub"
        title={t("oss.title")}
        link={{ href: `https://github.com/${profile.github}`, label: t("oss.all") }}
      />
      <Repositories repositories={repositories} />
    </section>
  )}
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(3.5rem, 2rem + 7vw, 8rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .hero__copy {
    display: grid;
    justify-items: start;
  }

  /* The editor is decoration: it needs room for a 48-character line, so phones go without. */
  .hero__visual {
    display: none;
  }

  @media (width >= 48rem) {
    .hero__visual {
      display: block;
      width: min(100%, 31rem);
      margin-block-start: 3.5rem;
    }
  }

  @media (width >= 68rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 29rem;
      column-gap: 3rem;
      align-items: center;
    }

    .hero__visual {
      width: auto;
      margin-block-start: 0;
    }

    .hero__title {
      font-size: clamp(3.5rem, 0.5rem + 4.6vw, 5rem);
    }

    .stats {
      grid-column: 1 / -1;
    }
  }

  .hero__title {
    display: grid;
    margin-block: 1.75rem 1.5rem;
  }

  .hero__headline {
    color: var(--ink-faint);
  }

  .hero__intro {
    max-width: 40ch;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  .hero__note {
    margin-block-start: 1.25rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    width: 100%;
    margin-block-start: clamp(3rem, 2rem + 4vw, 5rem);
    overflow: hidden;
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    border-inline-start: 1px solid var(--rule);
    margin-inline-start: -1px;
  }

  .stats__value {
    font-weight: 600;
    font-size: var(--text-step-3);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* Counts tick up from zero: a registered integer animates, and a counter prints it. */
  @property --stat-n {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }

  .stats__count {
    --stat-n: var(--to);
    counter-reset: stat var(--stat-n);
  }

  .stats__count::after {
    content: counter(stat);
  }

  @media (prefers-reduced-motion: no-preference) {
    .stats__count {
      animation: count 1.8s var(--ease-out-expo) 500ms backwards;
    }
  }

  @keyframes count {
    from {
      --stat-n: 0;
    }
  }

  .stats__label {
    font-size: var(--text-step--1);
    color: var(--ink-muted);
  }

  .section {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .bento > :global(.card) {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .bento__writing {
    grid-column: span 7;
    grid-row: span 2;
  }

  .bento__writing :global(.section-heading) {
    margin-block-end: 0.75rem;
  }

  .bento__lede {
    max-width: 48ch;
    margin-block-end: 1rem;
    color: var(--ink-muted);
    font-size: var(--text-step--1);
  }

  .bento__writing {
    display: flex;
    flex-direction: column;
  }

  .bento__topics {
    margin-block-start: auto;
    padding-block-start: 1.5rem;
  }

  .bento__topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .bento__hire,
  .bento__toolbox {
    grid-column: span 5;
  }

  .bento__now {
    grid-column: 1 / -1;
  }

  .bento__hire {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
    overflow: hidden;
  }

  .bento__glow {
    position: absolute;
    inset: -40% -30% auto auto;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow-1), transparent);
    pointer-events: none;
  }

  .bento__eyebrow {
    color: var(--accent);
  }

  .bento__title {
    margin-block: 0.5rem 1.25rem;
    font-weight: 600;
    font-size: var(--text-step-1);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .bento__now .bento__title {
    max-width: 48ch;
    font-size: var(--text-step-2);
  }

  .bento__services {
    display: grid;
    width: 100%;
  }

  .bento__service {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.75rem;
    border-block-start: 1px solid var(--rule);
    font-weight: 550;
    text-decoration: none;
  }

  .bento__service:hover {
    color: var(--accent);
  }

  .bento__service-summary {
    font-weight: 400;
    font-size: var(--text-step--1);
    color: var(--ink-muted);
  }

  @media (width < 56rem) {
    .bento__writing,
    .bento__hire,
    .bento__toolbox {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
