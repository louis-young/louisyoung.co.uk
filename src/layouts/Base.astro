---
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Palette from "../components/Palette.astro";
import RelatedTools from "../components/RelatedTools.astro";
import ShortcutsHelp from "../components/ShortcutsHelp.astro";
import Terminal from "../components/Terminal.astro";
import { localeOf } from "../i18n/astro";
import { useTranslations } from "../i18n";
import type { ToolSlug } from "../lib/tool-catalogue";
import { getSections } from "../components/palette-index";

type Props = Parameters<typeof Head>[0] & {
  /** Set on tool pages (via `toolPageProps`): adds related tools and records the visit. */
  tool?: ToolSlug;
};

const { tool, ...head } = Astro.props;

const locale = localeOf(Astro);
const t = useTranslations(locale);
/** Vercel Web Analytics is cookieless and served first-party, so it only exists on Vercel. */
const analytics = Boolean(process.env["VERCEL"]);
const sections = await getSections();
const showUses = sections.uses;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <Head {...head} />
    <slot name="head" />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">
      {t("nav.skip")}
    </a>
    <div class="backdrop" aria-hidden="true"></div>
    <Header sections={sections} />
    <main id="main" tabindex="-1">
      <slot />
      {tool && <RelatedTools slug={tool} />}
    </main>
    <Footer showUses={showUses} />
    <Palette />
    <Terminal
      pages={[
        ...(sections.work ? ["work"] : []),
        "writing",
        "snippets",
        "hire",
        ...(sections.cv ? ["cv"] : []),
        ...(sections.now ? ["now"] : []),
        ...(showUses ? ["uses"] : []),
        "tools",
        "stats",
        "changelog",
        "colophon",
        "accessibility",
        "tags",
        "map",
        "search",
      ]}
    />
    <ShortcutsHelp />
    <p class="visually-hidden" role="status" data-theme-status></p>
    <script>
      import { initClock } from "../scripts/clock";
      import { bindOpeners, lazyOpener } from "../scripts/lazy";
      import { initShortcuts } from "../scripts/shortcuts";
      import { initSpotlight } from "../scripts/spotlight";
      import { initTheme } from "../scripts/theme";

      initTheme();
      initClock();
      initSpotlight();

      // The palette, terminal and shortcuts help only load the first time someone opens them.
      const openPalette = lazyOpener(() => {
        // The palette's options come from a JSON index: fetch it alongside the code, not after it.
        const index = fetch(document.querySelector<HTMLElement>("#palette")?.dataset["index"] ?? "");
        // It may fail before the palette's code arrives to handle it, which isn't an unhandled error.
        index.catch(() => undefined);
        return import("../scripts/palette").then((module) => module.initPalette({ index }));
      });
      const openTerminal = lazyOpener(() => import("../scripts/terminal").then((module) => module.initTerminal()));
      const openHelp = lazyOpener(() =>
        import("../scripts/shortcuts-help").then((module) => module.initShortcutsHelp()),
      );
      bindOpeners("[data-palette-open]", openPalette);
      bindOpeners("[data-terminal-open]", openTerminal);
      bindOpeners("[data-shortcuts-open]", openHelp);
      document.addEventListener("terminal:open", openTerminal);
      document.addEventListener("shortcuts:open", openHelp);
      initShortcuts(openPalette, undefined, openTerminal, openHelp);
    </script>
    {analytics && <script is:inline defer src="/_vercel/insights/script.js" />}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 50;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    translate: 0 -200%;
    transition: translate var(--duration-base) var(--ease-out-expo);
  }

  .skip-link:focus-visible {
    translate: 0 0;
  }

  main {
    flex: 1;
    outline: none;
  }
</style>
