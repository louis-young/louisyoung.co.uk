---
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Palette from "../components/Palette.astro";
import { localeOf } from "../i18n/astro";
import { useTranslations } from "../i18n";
import { articlePath, getArticles } from "../lib/articles";
import { getEntry } from "astro:content";

import { cv } from "../../content/data/cv";
import { filled } from "../lib/placeholders";
import { getWork, isPagePublished, workPath } from "../lib/work";

type Props = Parameters<typeof Head>[0];

const locale = localeOf(Astro);
const t = useTranslations(locale);
/** Vercel Web Analytics is cookieless and served first-party, so it only exists on Vercel. */
const analytics = Boolean(process.env["VERCEL"]);
const work = await getWork();
const [nowPage, usesPage] = await Promise.all([getEntry("pages", "now"), getEntry("pages", "uses")]);
const sections = {
  work: work.length > 0,
  now: Boolean(nowPage && isPagePublished(nowPage)),
  cv: cv.roles.some((role) => filled(role.company)),
};
const showUses = Boolean(usesPage && isPagePublished(usesPage));
const paletteWork = work.map((study) => ({
  title: study.data.title,
  href: workPath(study),
  keywords: `${study.data.client} ${study.data.stack.join(" ")}`,
}));
const paletteArticles = (await getArticles()).map((article) => ({
  title: article.data.title,
  href: articlePath(article),
  keywords: article.data.tags.join(" "),
}));
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <Head {...Astro.props} />
    <slot name="head" />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">
      {t("nav.skip")}
    </a>
    <div class="backdrop" aria-hidden="true"></div>
    <Header sections={sections} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer showUses={showUses} />
    <Palette
      work={paletteWork}
      articles={paletteArticles}
      hidden={[
        ...(sections.work ? [] : ["/work/"]),
        ...(sections.now ? [] : ["/now/"]),
        ...(sections.cv ? [] : ["/cv/"]),
        ...(showUses ? [] : ["/uses/"]),
      ]}
    />
    <p class="visually-hidden" role="status" data-theme-status></p>
    <script>
      import { initClock } from "../scripts/clock";
      import { initPalette } from "../scripts/palette";
      import { initShortcuts } from "../scripts/shortcuts";
      import { initSpotlight } from "../scripts/spotlight";
      import { initTheme } from "../scripts/theme";

      initTheme();
      initClock();
      initSpotlight();
      initShortcuts(initPalette());
    </script>
    {analytics && <script is:inline defer src="/_vercel/insights/script.js" />}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 50;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    translate: 0 -200%;
    transition: translate var(--duration-base) var(--ease-out-expo);
  }

  .skip-link:focus-visible {
    translate: 0 0;
  }

  main {
    flex: 1;
    outline: none;
  }
</style>
